{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Solix",
  "scopeName": "source.solix",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.solix",
          "match": "//.*$"
        },
        {
          "name": "comment.block.solix",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.solix",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.solix",
              "match": "\\\\([0-7]{1,3}|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[abefnrtv\\\\'\"])"
            }
          ]
        },
        {
          "name": "string.quoted.single.solix",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.solix",
              "match": "\\\\([0-7]{1,3}|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|[abefnrtv\\\\'\"])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.solix",
          "match": "\\b0[xX][0-9a-fA-F_]+([uU]?[lL]{0,2}|[lL]{1,2}[uU]?)?\\b"
        },
        {
          "name": "constant.numeric.binary.solix",
          "match": "\\b0[bB][01_]+([uU]?[lL]{0,2}|[lL]{1,2}[uU]?)?\\b"
        },
        {
          "name": "constant.numeric.float.solix",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?(f|F|d|D)?\\b"
        },
        {
          "name": "constant.numeric.integer.solix",
          "match": "\\b[0-9][0-9_]*([uU]?[lL]{0,2}|[lL]{1,2}[uU]?)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.solix",
          "match": "\\b(if|else|while|do|for|switch|case|default|break|continue|return|throw|try|catch|finally)\\b"
        },
        {
          "name": "keyword.declaration.solix",
          "match": "\\b(class|interface|enum|struct|alias|package|import|function)\\b"
        },
        {
          "name": "storage.modifier.solix",
          "match": "\\b(public|private|protected|internal|static|virtual|override|abstract|native|const|inline|weak)\\b"
        },
        {
          "name": "keyword.operator.expression.solix",
          "match": "\\b(new|delete|sizeof|as|is|instanceof)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.solix",
          "match": "\\b(void|bool|char|int8|uint8|int16|uint16|int32|uint32|int64|uint64|float32|float64|string|var)\\b"
        },
        {
          "name": "storage.type.solix",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.solix",
          "match": "\\b(true|false|null|this|super)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.solix",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.solix",
          "match": "(&&|\\|\\||==|!=|<=|>=|<|>|\\+|-|\\*|/|%|\\+=|-=|\\*=|/=|%=|&|\\||\\^|~|<<|>>|&=|\\|=|\\^=|<<=|>>=|=|!|\\?|:)"
        }
      ]
    }
  }
}
