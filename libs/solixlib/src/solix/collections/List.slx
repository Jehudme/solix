package solix.collections;

import solix.core.IStringable;
import solix.core.String;
import solix.exceptions.IndexOutOfBoundsException;
import solix.exceptions.IllegalArgumentException;
import solix.exceptions.NoSuchElementException;

public class ListIterator<T> implements IIterator<T> {
    private T[] data;
    private int32 count;
    private int32 cursor;

    public ListIterator(T[] arr, int32 cnt) {
        this.data = arr;
        this.count = cnt;
        this.cursor = 0;
    }

    public bool has_next() {
        return this.cursor < this.count;
    }

    public T next() {
        if (this.cursor >= this.count) {
            throw new NoSuchElementException("Iterator exhausted");
        }
        T val = this.data[this.cursor];
        this.cursor = this.cursor + 1;
        return val;
    }
}

public class List<T> implements IList<T>, ICollection<T>, IIterable<T>, IStringable {
    private T[] _data;
    private int32 _size;

    public List() {
        this._data = new T[16];
        this._size = 0;
    }

    public List(int32 initial_capacity) {
        if (initial_capacity < 0) {
            throw new IllegalArgumentException("initial_capacity", "Initial capacity cannot be negative");
        }
        if (initial_capacity < 4) {
            initial_capacity = 4;
        }
        this._data = new T[initial_capacity];
        this._size = 0;
    }

    public List(T[] items) {
        if (items == null) {
            this._data = new T[16];
            this._size = 0;
        } else {
            int32 cap = items.length;
            if (cap < 4) {
                cap = 4;
            }
            this._data = new T[cap];
            this._size = items.length;
            for (int32 i = 0; i < items.length; i = i + 1) {
                this._data[i] = items[i];
            }
        }
    }

    public List(ICollection<T> other) {
        if (other == null) {
            this._data = new T[16];
            this._size = 0;
        } else {
            int32 cap = other.size();
            if (cap < 4) {
                cap = 4;
            }
            this._data = new T[cap];
            this._size = 0;
            IIterator<T> it = other.iterator();
            while (it.has_next()) {
                this._data[this._size] = it.next();
                this._size = this._size + 1;
            }
        }
    }

    public int32 size() {
        return this._size;
    }

    public int32 capacity() {
        return this._data.length;
    }

    public bool is_empty() {
        return this._size == 0;
    }

    public void clear() {
        for (int32 i = 0; i < this._size; i = i + 1) {
            this._data[i] = default(T);
        }
        this._size = 0;
    }

    public T[] to_array() {
        T[] copy = new T[this._size];
        for (int32 i = 0; i < this._size; i = i + 1) {
            copy[i] = this._data[i];
        }
        return copy;
    }

    public void ensure_capacity(int32 min_capacity) {
        if (min_capacity > this._data.length) {
            int32 new_cap = this._data.length * 2;
            if (new_cap < min_capacity) {
                new_cap = min_capacity;
            }
            T[] new_arr = new T[new_cap];
            for (int32 i = 0; i < this._size; i = i + 1) {
                new_arr[i] = this._data[i];
            }
            this._data = new_arr;
        }
    }

    public void shrink_to_fit() {
        if (this._data.length > this._size) {
            int32 new_cap = this._size > 4 ? this._size : 4;
            T[] new_arr = new T[new_cap];
            for (int32 i = 0; i < this._size; i = i + 1) {
                new_arr[i] = this._data[i];
            }
            this._data = new_arr;
        }
    }

    public T get(int32 index) {
        if (index < 0 || index >= this._size) {
            throw new IndexOutOfBoundsException("List index out of bounds", index, 0, this._size);
        }
        return this._data[index];
    }

    public T set(int32 index, T item) {
        if (index < 0 || index >= this._size) {
            throw new IndexOutOfBoundsException("List index out of bounds", index, 0, this._size);
        }
        T old = this._data[index];
        this._data[index] = item;
        return old;
    }

    public void add(T item) {
        this.ensure_capacity(this._size + 1);
        this._data[this._size] = item;
        this._size = this._size + 1;
    }

    public void insert(int32 index, T item) {
        if (index < 0 || index > this._size) {
            throw new IndexOutOfBoundsException("List insert index out of bounds", index, 0, this._size);
        }
        this.ensure_capacity(this._size + 1);
        for (int32 i = this._size - 1; i >= index; i = i - 1) {
            this._data[i + 1] = this._data[i];
        }
        this._data[index] = item;
        this._size = this._size + 1;
    }

    public T remove_at(int32 index) {
        if (index < 0 || index >= this._size) {
            throw new IndexOutOfBoundsException("List remove_at index out of bounds", index, 0, this._size);
        }
        T old = this._data[index];
        for (int32 i = index; i < this._size - 1; i = i + 1) {
            this._data[i] = this._data[i + 1];
        }
        this._data[this._size - 1] = default(T);
        this._size = this._size - 1;
        return old;
    }

    public bool remove(T item) {
        int32 idx = this.index_of(item);
        if (idx != -1) {
            this.remove_at(idx);
            return true;
        }
        return false;
    }

    public int32 index_of(T item) {
        for (int32 i = 0; i < this._size; i = i + 1) {
            if (this._data[i] == item) {
                return i;
            }
        }
        return -1;
    }

    public bool contains(T item) {
        return this.index_of(item) != -1;
    }

    public List<T> sub_list(int32 start, int32 count) {
        if (start < 0 || count < 0 || start + count > this._size) {
            throw new IndexOutOfBoundsException("sub_list range out of bounds", start, 0, this._size);
        }
        List<T> result = new List<T>(count);
        for (int32 i = 0; i < count; i = i + 1) {
            result.add(this._data[start + i]);
        }
        return result;
    }

    public void reverse() {
        for (int32 i = 0; i < this._size / 2; i = i + 1) {
            T temp = this._data[i];
            this._data[i] = this._data[this._size - 1 - i];
            this._data[this._size - 1 - i] = temp;
        }
    }

    public void for_each(void(*)(T) action) {
        for (int32 i = 0; i < this._size; i = i + 1) {
            action(this._data[i]);
        }
    }

    public List<T> filter(bool(*)(T) predicate) {
        List<T> result = new List<T>();
        for (int32 i = 0; i < this._size; i = i + 1) {
            if (predicate(this._data[i])) {
                result.add(this._data[i]);
            }
        }
        return result;
    }

    public List<U> map<U>(U(*)(T) transform) {
        List<U> result = new List<U>(this._size);
        for (int32 i = 0; i < this._size; i = i + 1) {
            result.add(transform(this._data[i]));
        }
        return result;
    }

    public T reduce(T initial_value, T(*)(T, T) accumulator) {
        T current = initial_value;
        for (int32 i = 0; i < this._size; i = i + 1) {
            current = accumulator(current, this._data[i]);
        }
        return current;
    }

    public T reduce(T(*)(T, T) accumulator) {
        if (this._size == 0) {
            throw new NoSuchElementException("Cannot reduce an empty list");
        }
        T current = this._data[0];
        for (int32 i = 1; i < this._size; i = i + 1) {
            current = accumulator(current, this._data[i]);
        }
        return current;
    }

    public IIterator<T> iterator() {
        return new ListIterator<T>(this._data, this._size);
    }

    public String to_string() {
        return new String("[List]");
    }
}
