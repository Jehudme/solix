package raylib.types;

import solix.core.String;

public class BoneInfo {
    public String name;
    public int32 parent;

    public BoneInfo() {
        this.name = "";
        this.parent = 0;
    }

    public BoneInfo(String name, int32 parent) {
        this.name = name;
        this.parent = parent;
    }

}
