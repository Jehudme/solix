package raylib.types;

import raylib.types.Color;
import raylib.types.Texture2D;

public class MaterialMap {
    public Texture2D texture;
    public Color color;
    public float32 value;

    public MaterialMap() {
        this.texture = new Texture2D();
        this.color = new Color();
        this.value = 0.0;
    }

    public MaterialMap(Texture2D texture, Color color, float32 value) {
        this.texture = texture;
        this.color = color;
        this.value = value;
    }

}
