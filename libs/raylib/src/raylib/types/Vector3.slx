package raylib.types;

public class Vector3 {
    public float32 x;
    public float32 y;
    public float32 z;

    public Vector3() {
        this.x = 0.0;
        this.y = 0.0;
        this.z = 0.0;
    }

    public Vector3(float32 x, float32 y, float32 z) {
        this.x = x;
        this.y = y;
        this.z = z;
    }
}
