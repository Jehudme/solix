package raylib.types;

public class Vector4 {
    public float32 x;
    public float32 y;
    public float32 z;
    public float32 w;

    public Vector4() {
        this.x = 0.0;
        this.y = 0.0;
        this.z = 0.0;
        this.w = 0.0;
    }

    public Vector4(float32 x, float32 y, float32 z, float32 w) {
        this.x = x;
        this.y = y;
        this.z = z;
        this.w = w;
    }

}
