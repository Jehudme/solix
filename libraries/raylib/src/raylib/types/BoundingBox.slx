package raylib.types;

import raylib.types.Vector3;

public class BoundingBox {
    public Vector3 min;
    public Vector3 max;

    public BoundingBox() {
        this.min = new Vector3();
        this.max = new Vector3();
    }

    public BoundingBox(Vector3 min, Vector3 max) {
        this.min = min;
        this.max = max;
    }

}
