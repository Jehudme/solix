package solix.core;

import solix.exceptions.FormatException;

public class Long implements IStringable, IHashable {
    public static int64 MIN_VALUE = -9223372036854775807L - 1L;
    public static int64 MAX_VALUE = 9223372036854775807L;

    private int64 _value;

    public Long(int64 val) {
        this._value = val;
    }

    public int64 value() {
        return this._value;
    }

    public String to_string() {
        return String.value_of(this._value);
    }

    public int32 hash_code() {
        return (int32)this._value;
    }

    public bool equals(Long other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public int32 compare_to(Long other) {
        if (this._value < other._value) return -1;
        if (this._value > other._value) return 1;
        return 0;
    }

    public Long operator+(Long other) {
        return new Long(this._value + other._value);
    }

    public Long operator-(Long other) {
        return new Long(this._value - other._value);
    }

    public Long operator*(Long other) {
        return new Long(this._value * other._value);
    }

    public Long operator/(Long other) {
        return new Long(this._value / other._value);
    }

    public bool operator==(Long other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public bool operator!=(Long other) {
        if (other == null) return true;
        return this._value != other._value;
    }

    public bool operator<(Long other) {
        return this._value < other._value;
    }

    public bool operator<=(Long other) {
        return this._value <= other._value;
    }

    public bool operator>(Long other) {
        return this._value > other._value;
    }

    public bool operator>=(Long other) {
        return this._value >= other._value;
    }

    public static int64 parse(String s) {
        return String.parse_long(s);
    }
}
