package solix.core;

import solix.exceptions.FormatException;

public class ULong implements IStringable, IHashable {
    public static uint64 MIN_VALUE = (uint64)0;
    public static uint64 MAX_VALUE = (uint64)-1;

    private uint64 _value;

    public ULong(uint64 val) {
        this._value = val;
    }

    public uint64 value() {
        return this._value;
    }

    public String to_string() {
        return String.value_of((int64)this._value);
    }

    public int32 hash_code() {
        return (int32)this._value;
    }

    public bool equals(ULong other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public int32 compare_to(ULong other) {
        if (this._value < other._value) return -1;
        if (this._value > other._value) return 1;
        return 0;
    }

    public ULong operator+(ULong other) {
        return new ULong(this._value + other._value);
    }

    public ULong operator-(ULong other) {
        return new ULong(this._value - other._value);
    }

    public ULong operator*(ULong other) {
        return new ULong(this._value * other._value);
    }

    public ULong operator/(ULong other) {
        return new ULong(this._value / other._value);
    }

    public bool operator==(ULong other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public bool operator!=(ULong other) {
        if (other == null) return true;
        return this._value != other._value;
    }

    public bool operator<(ULong other) {
        return this._value < other._value;
    }

    public bool operator<=(ULong other) {
        return this._value <= other._value;
    }

    public bool operator>(ULong other) {
        return this._value > other._value;
    }

    public bool operator>=(ULong other) {
        return this._value >= other._value;
    }

    public static uint64 parse(String s) {
        return (uint64)String.parse_long(s);
    }
}
