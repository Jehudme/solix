package solix.core;

import solix.exceptions.FormatException;

public class Short implements IStringable, IHashable {
    public static int16 MIN_VALUE = -32768;
    public static int16 MAX_VALUE = 32767;

    private int16 _value;

    public Short(int16 val) {
        this._value = val;
    }

    public int16 value() {
        return this._value;
    }

    public String to_string() {
        return String.value_of((int32)this._value);
    }

    public int32 hash_code() {
        return (int32)this._value;
    }

    public bool equals(Short other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public int32 compare_to(Short other) {
        if (this._value < other._value) return -1;
        if (this._value > other._value) return 1;
        return 0;
    }

    public Short operator+(Short other) {
        return new Short((int16)(this._value + other._value));
    }

    public Short operator-(Short other) {
        return new Short((int16)(this._value - other._value));
    }

    public Short operator*(Short other) {
        return new Short((int16)(this._value * other._value));
    }

    public Short operator/(Short other) {
        return new Short((int16)(this._value / other._value));
    }

    public bool operator==(Short other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public bool operator!=(Short other) {
        if (other == null) return true;
        return this._value != other._value;
    }

    public bool operator<(Short other) {
        return this._value < other._value;
    }

    public bool operator<=(Short other) {
        return this._value <= other._value;
    }

    public bool operator>(Short other) {
        return this._value > other._value;
    }

    public bool operator>=(Short other) {
        return this._value >= other._value;
    }

    public static int16 parse(String s) {
        int32 v = String.parse_int(s);
        if (v < -32768 || v > 32767) {
            throw new FormatException("Short value out of range");
        }
        return (int16)v;
    }
}
