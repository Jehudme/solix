package solix.core;

import solix.exceptions.FormatException;

public class Double implements IStringable {
    public static float64 NaN = Double.nan();
    public static float64 POSITIVE_INFINITY = Double.positive_infinity();
    public static float64 NEGATIVE_INFINITY = Double.negative_infinity();
    public static float64 MIN_VALUE = Double.min_value();
    public static float64 MAX_VALUE = Double.max_value();

    private float64 _value;

    public Double(float64 val) {
        this._value = val;
    }

    public float64 value() {
        return this._value;
    }

    public String to_string() {
        return String.value_of(this._value);
    }

    public bool equals(Double other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public int32 compare_to(Double other) {
        if (this._value < other._value) return -1;
        if (this._value > other._value) return 1;
        return 0;
    }

    public Double operator+(Double other) {
        return new Double(this._value + other._value);
    }

    public Double operator-(Double other) {
        return new Double(this._value - other._value);
    }

    public Double operator*(Double other) {
        return new Double(this._value * other._value);
    }

    public Double operator/(Double other) {
        return new Double(this._value / other._value);
    }

    public bool operator==(Double other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public bool operator!=(Double other) {
        if (other == null) return true;
        return this._value != other._value;
    }

    public bool operator<(Double other) {
        return this._value < other._value;
    }

    public bool operator<=(Double other) {
        return this._value <= other._value;
    }

    public bool operator>(Double other) {
        return this._value > other._value;
    }

    public bool operator>=(Double other) {
        return this._value >= other._value;
    }

    public static float64 parse(String s) {
        return String.parse_double(s);
    }

    public static bool is_nan(float64 d) {
        return native_is_nan(d);
    }

    public static bool is_infinite(float64 d) {
        return native_is_infinite(d);
    }

    public static float64 nan() {
        return native_nan();
    }

    public static float64 positive_infinity() {
        return native_pos_inf();
    }

    public static float64 negative_infinity() {
        return native_neg_inf();
    }

    public static float64 min_value() {
        return native_min_value();
    }

    public static float64 max_value() {
        return native_max_value();
    }

    private static native float64 native_min_value();
    private static native float64 native_max_value();
    private static native float64 native_nan();
    private static native float64 native_pos_inf();
    private static native float64 native_neg_inf();
    private static native bool native_is_nan(float64 val);
    private static native bool native_is_infinite(float64 val);
}
