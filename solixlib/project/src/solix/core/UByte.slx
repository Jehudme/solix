package solix.core;

import solix.exceptions.FormatException;

public class UByte implements IStringable, IHashable {
    public static uint8 MIN_VALUE = (uint8)0;
    public static uint8 MAX_VALUE = (uint8)255;

    private uint8 _value;

    public UByte(uint8 val) {
        this._value = val;
    }

    public uint8 value() {
        return this._value;
    }

    public String to_string() {
        return String.value_of((int32)this._value);
    }

    public int32 hash_code() {
        return (int32)this._value;
    }

    public bool equals(UByte other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public int32 compare_to(UByte other) {
        if (this._value < other._value) return -1;
        if (this._value > other._value) return 1;
        return 0;
    }

    public UByte operator+(UByte other) {
        return new UByte((uint8)(this._value + other._value));
    }

    public UByte operator-(UByte other) {
        return new UByte((uint8)(this._value - other._value));
    }

    public UByte operator*(UByte other) {
        return new UByte((uint8)(this._value * other._value));
    }

    public UByte operator/(UByte other) {
        return new UByte((uint8)(this._value / other._value));
    }

    public bool operator==(UByte other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public bool operator!=(UByte other) {
        if (other == null) return true;
        return this._value != other._value;
    }

    public bool operator<(UByte other) {
        return this._value < other._value;
    }

    public bool operator<=(UByte other) {
        return this._value <= other._value;
    }

    public bool operator>(UByte other) {
        return this._value > other._value;
    }

    public bool operator>=(UByte other) {
        return this._value >= other._value;
    }

    public static uint8 parse(String s) {
        int32 v = String.parse_int(s);
        if (v < 0 || v > 255) {
            throw new FormatException("UByte value out of range");
        }
        return (uint8)v;
    }
}
