package solix.core;

import solix.exceptions.FormatException;

public class UShort implements IStringable, IHashable {
    public static uint16 MIN_VALUE = (uint16)0;
    public static uint16 MAX_VALUE = (uint16)65535;

    private uint16 _value;

    public UShort(uint16 val) {
        this._value = val;
    }

    public uint16 value() {
        return this._value;
    }

    public String to_string() {
        return String.value_of((int32)this._value);
    }

    public int32 hash_code() {
        return (int32)this._value;
    }

    public bool equals(UShort other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public int32 compare_to(UShort other) {
        if (this._value < other._value) return -1;
        if (this._value > other._value) return 1;
        return 0;
    }

    public UShort operator+(UShort other) {
        return new UShort((uint16)(this._value + other._value));
    }

    public UShort operator-(UShort other) {
        return new UShort((uint16)(this._value - other._value));
    }

    public UShort operator*(UShort other) {
        return new UShort((uint16)(this._value * other._value));
    }

    public UShort operator/(UShort other) {
        return new UShort((uint16)(this._value / other._value));
    }

    public bool operator==(UShort other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public bool operator!=(UShort other) {
        if (other == null) return true;
        return this._value != other._value;
    }

    public bool operator<(UShort other) {
        return this._value < other._value;
    }

    public bool operator<=(UShort other) {
        return this._value <= other._value;
    }

    public bool operator>(UShort other) {
        return this._value > other._value;
    }

    public bool operator>=(UShort other) {
        return this._value >= other._value;
    }

    public static uint16 parse(String s) {
        int32 v = String.parse_int(s);
        if (v < 0 || v > 65535) {
            throw new FormatException("UShort value out of range");
        }
        return (uint16)v;
    }
}
