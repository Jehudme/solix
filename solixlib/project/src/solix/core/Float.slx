package solix.core;

import solix.exceptions.FormatException;

public class Float implements IStringable {
    public static float32 MIN_VALUE = (float32)0.00000001;
    public static float32 MAX_VALUE = (float32)340282350000000000000000000000000000000.0;

    private float32 _value;

    public Float(float32 val) {
        this._value = val;
    }

    public float32 value() {
        return this._value;
    }

    public String to_string() {
        return String.value_of((float64)this._value);
    }

    public bool equals(Float other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public int32 compare_to(Float other) {
        if (this._value < other._value) return -1;
        if (this._value > other._value) return 1;
        return 0;
    }

    public Float operator+(Float other) {
        return new Float((float32)(this._value + other._value));
    }

    public Float operator-(Float other) {
        return new Float((float32)(this._value - other._value));
    }

    public Float operator*(Float other) {
        return new Float((float32)(this._value * other._value));
    }

    public Float operator/(Float other) {
        return new Float((float32)(this._value / other._value));
    }

    public bool operator==(Float other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public bool operator!=(Float other) {
        if (other == null) return true;
        return this._value != other._value;
    }

    public bool operator<(Float other) {
        return this._value < other._value;
    }

    public bool operator<=(Float other) {
        return this._value <= other._value;
    }

    public bool operator>(Float other) {
        return this._value > other._value;
    }

    public bool operator>=(Float other) {
        return this._value >= other._value;
    }

    public static float32 parse(String s) {
        return (float32)String.parse_double(s);
    }
}
