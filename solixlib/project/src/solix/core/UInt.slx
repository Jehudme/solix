package solix.core;

import solix.exceptions.FormatException;

public class UInt implements IStringable, IHashable {
    public static uint32 MIN_VALUE = (uint32)0;
    public static uint32 MAX_VALUE = (uint32)4294967295;

    private uint32 _value;

    public UInt(uint32 val) {
        this._value = val;
    }

    public uint32 value() {
        return this._value;
    }

    public String to_string() {
        return String.value_of((int64)this._value);
    }

    public int32 hash_code() {
        return (int32)this._value;
    }

    public bool equals(UInt other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public int32 compare_to(UInt other) {
        if (this._value < other._value) return -1;
        if (this._value > other._value) return 1;
        return 0;
    }

    public UInt operator+(UInt other) {
        return new UInt(this._value + other._value);
    }

    public UInt operator-(UInt other) {
        return new UInt(this._value - other._value);
    }

    public UInt operator*(UInt other) {
        return new UInt(this._value * other._value);
    }

    public UInt operator/(UInt other) {
        return new UInt(this._value / other._value);
    }

    public bool operator==(UInt other) {
        if (other == null) return false;
        return this._value == other._value;
    }

    public bool operator!=(UInt other) {
        if (other == null) return true;
        return this._value != other._value;
    }

    public bool operator<(UInt other) {
        return this._value < other._value;
    }

    public bool operator<=(UInt other) {
        return this._value <= other._value;
    }

    public bool operator>(UInt other) {
        return this._value > other._value;
    }

    public bool operator>=(UInt other) {
        return this._value >= other._value;
    }

    public static uint32 parse(String s) {
        int64 v = String.parse_long(s);
        if (v < 0L || v > 4294967295L) {
            throw new FormatException("UInt value out of range");
        }
        return (uint32)v;
    }
}
