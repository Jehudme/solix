package solix.core;

import solix.exceptions.InvalidOperationException;

public class Any implements IStringable, IHashable, IEquatable {
    private int32 _kind; // 0=null, 1=int32, 2=float64, 3=bool, 4=char, 5=string, 6=object
    private int32 _int_val;
    private float64 _float_val;
    private bool _bool_val;
    private char _char_val;
    private String _str_val;
    private IStringable _obj_val;

    public Any() {
        this._kind = 0;
    }

    public Any(int32 val) {
        this._kind = 1;
        this._int_val = val;
    }

    public Any(float64 val) {
        this._kind = 2;
        this._float_val = val;
    }

    public Any(bool val) {
        this._kind = 3;
        this._bool_val = val;
    }

    public Any(char val) {
        this._kind = 4;
        this._char_val = val;
    }

    public Any(String val) {
        this._kind = 5;
        this._str_val = val;
    }

    public Any(IStringable val) {
        this._kind = 6;
        this._obj_val = val;
    }

    public static Any from_int(int32 val) {
        return new Any(val);
    }

    public static Any from_double(float64 val) {
        return new Any(val);
    }

    public static Any from_bool(bool val) {
        return new Any(val);
    }

    public static Any from_char(char val) {
        return new Any(val);
    }

    public static Any from_string(String val) {
        return new Any(val);
    }

    public static Any from_object(IStringable val) {
        return new Any(val);
    }

    public bool is_null() { return this._kind == 0; }
    public bool is_int() { return this._kind == 1; }
    public bool is_double() { return this._kind == 2; }
    public bool is_bool() { return this._kind == 3; }
    public bool is_char() { return this._kind == 4; }
    public bool is_string() { return this._kind == 5; }
    public bool is_object() { return this._kind == 6; }

    public int32 as_int() {
        if (this._kind != 1) {
            throw new InvalidOperationException("Any does not contain an int32 value.");
        }
        return this._int_val;
    }

    public float64 as_double() {
        if (this._kind != 2) {
            throw new InvalidOperationException("Any does not contain a float64 value.");
        }
        return this._float_val;
    }

    public bool as_bool() {
        if (this._kind != 3) {
            throw new InvalidOperationException("Any does not contain a bool value.");
        }
        return this._bool_val;
    }

    public char as_char() {
        if (this._kind != 4) {
            throw new InvalidOperationException("Any does not contain a char value.");
        }
        return this._char_val;
    }

    public String as_string() {
        if (this._kind != 5) {
            throw new InvalidOperationException("Any does not contain a String value.");
        }
        return this._str_val;
    }

    public IStringable as_object() {
        if (this._kind != 6) {
            throw new InvalidOperationException("Any does not contain an object value.");
        }
        return this._obj_val;
    }

    public String type_name() {
        if (this._kind == 1) return new String("int32");
        if (this._kind == 2) return new String("float64");
        if (this._kind == 3) return new String("bool");
        if (this._kind == 4) return new String("char");
        if (this._kind == 5) return new String("String");
        if (this._kind == 6) return new String("Object");
        return new String("null");
    }

    public String to_string() {
        if (this._kind == 1) return String.value_of(this._int_val);
        if (this._kind == 2) return String.value_of(this._float_val);
        if (this._kind == 3) return String.value_of(this._bool_val);
        if (this._kind == 4) return String.value_of(this._char_val);
        if (this._kind == 5) return this._str_val;
        if (this._kind == 6) {
            if (this._obj_val == null) return new String("null");
            return this._obj_val.to_string();
        }
        return new String("null");
    }

    public int32 hash_code() {
        if (this._kind == 1) return this._int_val;
        if (this._kind == 3) return this._bool_val ? 1231 : 1237;
        if (this._kind == 4) return this._char_val;
        if (this._kind == 5) return this._str_val.hash_code();
        return 0;
    }

    public bool equals(Any other) {
        if (other == null) return false;
        if (this._kind != other._kind) return false;
        if (this._kind == 0) return true;
        if (this._kind == 1) return this._int_val == other._int_val;
        if (this._kind == 2) return this._float_val == other._float_val;
        if (this._kind == 3) return this._bool_val == other._bool_val;
        if (this._kind == 4) return this._char_val == other._char_val;
        if (this._kind == 5) return this._str_val.equals(other._str_val);
        return false;
    }
}
