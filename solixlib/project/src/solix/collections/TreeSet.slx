package solix.collections;

import solix.core.IStringable;
import solix.core.String;
import solix.exceptions.NoSuchElementException;

public class TreeSetIterator<T> {
    private List<T> _keys;
    private int32 _idx;

    public TreeSetIterator(List<T> keys) {
        this._keys = keys;
        this._idx = 0;
    }

    public bool has_next() {
        return this._idx < this._keys.size();
    }

    public T next() {
        if (this._idx >= this._keys.size()) {
            throw new NoSuchElementException("Iterator exhausted");
        }
        T val = this._keys.get(this._idx);
        this._idx = this._idx + 1;
        return val;
    }
}

public class TreeSet<T> implements IStringable {
    private TreeMap<T, bool> _map;

    public TreeSet() {
        this._map = new TreeMap<T, bool>();
    }

    public TreeSet(int32(*)(T, T) comparator) {
        this._map = new TreeMap<T, bool>(comparator);
    }

    public int32 size() {
        return this._map.size();
    }

    public bool is_empty() {
        return this._map.is_empty();
    }

    public void clear() {
        this._map.clear();
    }

    public bool contains(T item) {
        return this._map.contains_key(item);
    }

    public bool add(T item) {
        if (this._map.contains_key(item)) {
            return false;
        }
        this._map.put(item, true);
        return true;
    }

    public bool remove(T item) {
        if (!this._map.contains_key(item)) {
            return false;
        }
        this._map.remove(item);
        return true;
    }

    public T first() {
        if (this.is_empty()) {
            throw new NoSuchElementException("TreeSet is empty");
        }
        return this._map.first_key();
    }

    public T last() {
        if (this.is_empty()) {
            throw new NoSuchElementException("TreeSet is empty");
        }
        return this._map.last_key();
    }

    public T[] to_array() {
        List<T> keys = this._map.keys();
        return keys.to_array();
    }

    public List<T> to_list() {
        return this._map.keys();
    }

    public TreeSetIterator<T> iterator() {
        return new TreeSetIterator<T>(this._map.keys());
    }

    public void for_each(void(*)(T) action) {
        if (action == null) return;
        List<T> keys = this._map.keys();
        for (int32 i = 0; i < keys.size(); i = i + 1) {
            action(keys.get(i));
        }
    }

    public void union_with(TreeSet<T> other) {
        if (other == null) return;
        List<T> keys = other._map.keys();
        for (int32 i = 0; i < keys.size(); i = i + 1) {
            this.add(keys.get(i));
        }
    }

    public void intersect_with(TreeSet<T> other) {
        if (other == null) {
            this.clear();
            return;
        }
        List<T> keys = this._map.keys();
        for (int32 i = 0; i < keys.size(); i = i + 1) {
            T item = keys.get(i);
            if (!other.contains(item)) {
                this.remove(item);
            }
        }
    }

    public void difference_with(TreeSet<T> other) {
        if (other == null) return;
        List<T> keys = other._map.keys();
        for (int32 i = 0; i < keys.size(); i = i + 1) {
            this.remove(keys.get(i));
        }
    }

    public bool is_subset_of(TreeSet<T> other) {
        if (other == null) return false;
        if (this.size() > other.size()) return false;
        List<T> keys = this._map.keys();
        for (int32 i = 0; i < keys.size(); i = i + 1) {
            if (!other.contains(keys.get(i))) return false;
        }
        return true;
    }

    public bool is_superset_of(TreeSet<T> other) {
        if (other == null) return true;
        if (other.size() > this.size()) return false;
        List<T> keys = other._map.keys();
        for (int32 i = 0; i < keys.size(); i = i + 1) {
            if (!this.contains(keys.get(i))) return false;
        }
        return true;
    }

    public String to_string() {
        return "[TreeSet]";
    }
}
