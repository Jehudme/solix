package solix.collections;

import solix.core.Any;
import solix.core.String;
import solix.core.StringBuilder;
import solix.exceptions.IllegalArgumentException;
import solix.exceptions.InvalidOperationException;
import solix.exceptions.NoSuchElementException;

public class CircularBufferIterator implements IIterator {
    private Any[] _data;
    private int32 _head;
    private int32 _capacity;
    private int32 _size;
    private int32 _idx;

    public CircularBufferIterator(Any[] buf, int32 head, int32 cap, int32 sz) {
        this._data = buf;
        this._head = head;
        this._capacity = cap;
        this._size = sz;
        this._idx = 0;
    }

    public bool has_next() {
        return this._idx < this._size;
    }

    public Any next() {
        if (this._idx >= this._size) {
            throw new NoSuchElementException("Iterator exhausted");
        }
        int32 pos = (this._head + this._idx) % this._capacity;
        this._idx = this._idx + 1;
        return this._data[pos];
    }
}

public class CircularBuffer implements ICollection {
    private Any[] _buffer;
    private int32 _capacity;
    private int32 _head;
    private int32 _tail;
    private int32 _size;
    private bool _overwrite;

    public CircularBuffer(int32 capacity) {
        if (capacity <= 0) {
            throw new IllegalArgumentException("capacity", "Capacity must be positive");
        }
        this._capacity = capacity;
        this._buffer = new Any[capacity];
        this._head = 0;
        this._tail = 0;
        this._size = 0;
        this._overwrite = false;
    }

    public CircularBuffer(int32 capacity, bool overwrite) {
        if (capacity <= 0) {
            throw new IllegalArgumentException("capacity", "Capacity must be positive");
        }
        this._capacity = capacity;
        this._buffer = new Any[capacity];
        this._head = 0;
        this._tail = 0;
        this._size = 0;
        this._overwrite = overwrite;
    }

    public int32 capacity() {
        return this._capacity;
    }

    public int32 size() {
        return this._size;
    }

    public bool is_empty() {
        return this._size == 0;
    }

    public bool is_full() {
        return this._size == this._capacity;
    }

    public bool is_overwrite() {
        return this._overwrite;
    }

    public bool write(Any item) {
        if (this.is_full()) {
            if (!this._overwrite) {
                return false;
            }
            this._head = (this._head + 1) % this._capacity;
            this._buffer[this._tail] = item;
            this._tail = (this._tail + 1) % this._capacity;
            return true;
        }
        this._buffer[this._tail] = item;
        this._tail = (this._tail + 1) % this._capacity;
        this._size += 1;
        return true;
    }

    public void enqueue(Any item) {
        if (this.is_full() && !this._overwrite) {
            throw new InvalidOperationException("CircularBuffer is full");
        }
        this.write(item);
    }

    public Any read() {
        if (this.is_empty()) {
            throw new InvalidOperationException("CircularBuffer is empty");
        }
        Any item = this._buffer[this._head];
        this._buffer[this._head] = null;
        this._head = (this._head + 1) % this._capacity;
        this._size -= 1;
        return item;
    }

    public Any dequeue() {
        return this.read();
    }

    public Any peek() {
        if (this.is_empty()) {
            throw new InvalidOperationException("CircularBuffer is empty");
        }
        return this._buffer[this._head];
    }

    public void clear() {
        for (int32 i = 0; i < this._capacity; i++) {
            this._buffer[i] = null;
        }
        this._head = 0;
        this._tail = 0;
        this._size = 0;
    }

    public bool contains(Any item) {
        for (int32 i = 0; i < this._size; i++) {
            int32 idx = (this._head + i) % this._capacity;
            Any cur = this._buffer[idx];
            if (cur == null && item == null) return true;
            if (cur != null && cur.equals(item)) return true;
        }
        return false;
    }

    public Any[] to_array() {
        Any[] arr = new Any[this._size];
        for (int32 i = 0; i < this._size; i++) {
            int32 idx = (this._head + i) % this._capacity;
            arr[i] = this._buffer[idx];
        }
        return arr;
    }

    public IIterator iterator() {
        return new CircularBufferIterator(this._buffer, this._head, this._capacity, this._size);
    }

    public String to_string() {
        StringBuilder sb = new StringBuilder("[");
        for (int32 i = 0; i < this._size; i++) {
            if (i > 0) sb.append(", ");
            int32 idx = (this._head + i) % this._capacity;
            Any cur = this._buffer[idx];
            if (cur == null) {
                sb.append("null");
            } else {
                sb.append(cur.to_string());
            }
        }
        sb.append("]");
        return sb.to_string();
    }
}
