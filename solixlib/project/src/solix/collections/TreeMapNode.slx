package solix.collections;

public class TreeMapNode<K, V> {
    public K key;
    public V value;
    public TreeMapNode<K, V> left;
    public TreeMapNode<K, V> right;
    public TreeMapNode<K, V> parent;

    public TreeMapNode(K k, V v, TreeMapNode<K, V> p) {
        this.key = k;
        this.value = v;
        this.parent = p;
        this.left = null;
        this.right = null;
    }
}
