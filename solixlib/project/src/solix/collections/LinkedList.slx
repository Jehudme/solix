package solix.collections;

import solix.core.Any;
import solix.core.String;
import solix.exceptions.IndexOutOfBoundsException;
import solix.exceptions.NoSuchElementException;

public class LinkedListIterator implements IIterator {
    private LinkedListNode _current;

    public LinkedListIterator(LinkedListNode head) {
        this._current = head;
    }

    public bool has_next() {
        return this._current != null;
    }

    public Any next() {
        if (this._current == null) {
            throw new NoSuchElementException("Iterator exhausted");
        }
        Any val = this._current.value;
        this._current = this._current.next;
        return val;
    }
}

public class LinkedList implements IList, IDeque {
    private LinkedListNode _head;
    private LinkedListNode _tail;
    private int32 _count;

    public LinkedList() {
        this._head = null;
        this._tail = null;
        this._count = 0;
    }

    public int32 size() {
        return this._count;
    }

    public bool is_empty() {
        return this._count == 0;
    }

    public void clear() {
        LinkedListNode cur = this._head;
        while (cur != null) {
            LinkedListNode nxt = cur.next;
            cur.prev = null;
            cur.next = null;
            cur = nxt;
        }
        this._head = null;
        this._tail = null;
        this._count = 0;
    }

    public Any[] to_array() {
        Any[] arr = new Any[this._count];
        LinkedListNode cur = this._head;
        int32 idx = 0;
        while (cur != null) {
            arr[idx] = cur.value;
            cur = cur.next;
            idx = idx + 1;
        }
        return arr;
    }

    public void add_first(Any item) {
        LinkedListNode node = new LinkedListNode(item);
        if (this._head == null) {
            this._head = node;
            this._tail = node;
        } else {
            node.next = this._head;
            this._head.prev = node;
            this._head = node;
        }
        this._count = this._count + 1;
    }

    public void add_last(Any item) {
        LinkedListNode node = new LinkedListNode(item);
        if (this._tail == null) {
            this._head = node;
            this._tail = node;
        } else {
            this._tail.next = node;
            node.prev = this._tail;
            this._tail = node;
        }
        this._count = this._count + 1;
    }

    public Any remove_first() {
        if (this._head == null) {
            throw new NoSuchElementException("LinkedList is empty");
        }
        Any val = this._head.value;
        this._head = this._head.next;
        if (this._head == null) {
            this._tail = null;
        } else {
            this._head.prev = null;
        }
        this._count = this._count - 1;
        return val;
    }

    public Any remove_last() {
        if (this._tail == null) {
            throw new NoSuchElementException("LinkedList is empty");
        }
        Any val = this._tail.value;
        this._tail = this._tail.prev;
        if (this._tail == null) {
            this._head = null;
        } else {
            this._tail.next = null;
        }
        this._count = this._count - 1;
        return val;
    }

    public Any peek_first() {
        if (this._head == null) {
            throw new NoSuchElementException("LinkedList is empty");
        }
        return this._head.value;
    }

    public Any peek_last() {
        if (this._tail == null) {
            throw new NoSuchElementException("LinkedList is empty");
        }
        return this._tail.value;
    }

    public void add(Any item) {
        this.add_last(item);
    }

    private LinkedListNode node_at(int32 index) {
        if (index < 0 || index >= this._count) {
            throw new IndexOutOfBoundsException("LinkedList index out of bounds", index, 0, this._count);
        }
        if (index < this._count / 2) {
            LinkedListNode cur = this._head;
            for (int32 i = 0; i < index; i = i + 1) {
                cur = cur.next;
            }
            return cur;
        } else {
            LinkedListNode cur = this._tail;
            for (int32 i = this._count - 1; i > index; i = i - 1) {
                cur = cur.prev;
            }
            return cur;
        }
    }

    public Any get(int32 index) {
        LinkedListNode node = this.node_at(index);
        return node.value;
    }

    public Any set(int32 index, Any item) {
        LinkedListNode node = this.node_at(index);
        Any old = node.value;
        node.value = item;
        return old;
    }

    public void insert(int32 index, Any item) {
        if (index < 0 || index > this._count) {
            throw new IndexOutOfBoundsException("LinkedList insert index out of bounds", index, 0, this._count);
        }
        if (index == 0) {
            this.add_first(item);
        } else if (index == this._count) {
            this.add_last(item);
        } else {
            LinkedListNode target = this.node_at(index);
            LinkedListNode node = new LinkedListNode(item);
            node.prev = target.prev;
            node.next = target;
            target.prev.next = node;
            target.prev = node;
            this._count = this._count + 1;
        }
    }

    public Any remove_at(int32 index) {
        if (index < 0 || index >= this._count) {
            throw new IndexOutOfBoundsException("LinkedList remove_at index out of bounds", index, 0, this._count);
        }
        if (index == 0) {
            return this.remove_first();
        }
        if (index == this._count - 1) {
            return this.remove_last();
        }
        LinkedListNode node = this.node_at(index);
        Any val = node.value;
        node.prev.next = node.next;
        node.next.prev = node.prev;
        node.prev = null;
        node.next = null;
        this._count = this._count - 1;
        return val;
    }

    public bool remove(Any item) {
        LinkedListNode cur = this._head;
        while (cur != null) {
            bool match = false;
            if (item == null) {
                if (cur.value == null) {
                    match = true;
                }
            } else {
                if (cur.value != null && cur.value.equals(item)) {
                    match = true;
                }
            }
            if (match) {
                if (cur == this._head) {
                    this.remove_first();
                } else if (cur == this._tail) {
                    this.remove_last();
                } else {
                    cur.prev.next = cur.next;
                    cur.next.prev = cur.prev;
                    cur.prev = null;
                    cur.next = null;
                    this._count = this._count - 1;
                }
                return true;
            }
            cur = cur.next;
        }
        return false;
    }

    public int32 index_of(Any item) {
        LinkedListNode cur = this._head;
        int32 idx = 0;
        while (cur != null) {
            if (item == null) {
                if (cur.value == null) {
                    return idx;
                }
            } else {
                if (cur.value != null && cur.value.equals(item)) {
                    return idx;
                }
            }
            cur = cur.next;
            idx = idx + 1;
        }
        return -1;
    }

    public bool contains(Any item) {
        return this.index_of(item) != -1;
    }

    public IIterator iterator() {
        return new LinkedListIterator(this._head);
    }

    public String to_string() {
        return Collections.to_string(this);
    }
}
