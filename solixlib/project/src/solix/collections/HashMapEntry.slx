package solix.collections;

import solix.core.Any;

public class HashMapEntry {
    public Any key;
    public Any value;
    public int32 hash;
    public HashMapEntry next;

    public HashMapEntry(Any k, Any v, int32 h, HashMapEntry n) {
        this.key = k;
        this.value = v;
        this.hash = h;
        this.next = n;
    }
}
