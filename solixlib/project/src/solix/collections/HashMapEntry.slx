package solix.collections;

public class HashMapEntry<K, V> {
    public K key;
    public V value;
    public int32 hash;
    public HashMapEntry<K, V> next;

    public HashMapEntry(K k, V v, int32 h, HashMapEntry<K, V> n) {
        this.key = k;
        this.value = v;
        this.hash = h;
        this.next = n;
    }
}
