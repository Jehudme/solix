package solix.math;

public class Math {
    public static float64 PI = 3.141592653589793;
    public static float64 E = 2.718281828459045;
    public static float64 TAU = 6.283185307179586;
    public static float64 EPSILON = 0.000000000000001;

    // Basic arithmetic & bounds (generic)
    public static T abs<T>(T v) {
        if (v < default(T)) return -v;
        return v;
    }

    public static T min<T>(T a, T b) {
        if (a < b) return a;
        return b;
    }

    public static T max<T>(T a, T b) {
        if (a > b) return a;
        return b;
    }

    public static T clamp<T>(T val, T min_val, T max_val) {
        if (val < min_val) return min_val;
        if (val > max_val) return max_val;
        return val;
    }

    public static int32 sign<T>(T v) {
        if (v < default(T)) return -1;
        if (v > default(T)) return 1;
        return 0;
    }

    public static T copy_sign<T>(T magnitude, T sign_val) {
        T abs_m = abs<T>(magnitude);
        if (sign_val < default(T)) return -abs_m;
        return abs_m;
    }

    // Exponential & Logarithmic
    public static float64 sqrt(float64 v) { return native_sqrt(v); }
    public static float64 cbrt(float64 v) { return native_cbrt(v); }
    public static float64 hypot(float64 a, float64 b) { return native_hypot(a, b); }
    public static float64 pow(float64 b, float64 e) { return native_pow(b, e); }
    public static float64 exp(float64 v) { return native_exp(v); }
    public static float64 log(float64 v) { return native_log(v); }
    public static float64 log10(float64 v) { return native_log10(v); }
    public static float64 log2(float64 v) { return native_log2(v); }

    // Trigonometric
    public static float64 sin(float64 v) { return native_sin(v); }
    public static float64 cos(float64 v) { return native_cos(v); }
    public static float64 tan(float64 v) { return native_tan(v); }
    public static float64 asin(float64 v) { return native_asin(v); }
    public static float64 acos(float64 v) { return native_acos(v); }
    public static float64 atan(float64 v) { return native_atan(v); }
    public static float64 atan2(float64 y, float64 x) { return native_atan2(y, x); }
    public static float64 to_radians(float64 deg) { return deg * (PI / 180.0); }
    public static float64 to_degrees(float64 rad) { return rad * (180.0 / PI); }

    // Hyperbolic
    public static float64 sinh(float64 v) { return native_sinh(v); }
    public static float64 cosh(float64 v) { return native_cosh(v); }
    public static float64 tanh(float64 v) { return native_tanh(v); }

    // Rounding & Truncation
    public static float64 floor(float64 v) { return native_floor(v); }
    public static float64 ceil(float64 v) { return native_ceil(v); }
    public static float64 round(float64 v) { return native_round(v); }
    public static float64 trunc(float64 v) { return native_trunc(v); }

    // Native declarations
    private static native float64 native_sqrt(float64 v);
    private static native float64 native_cbrt(float64 v);
    private static native float64 native_hypot(float64 a, float64 b);
    private static native float64 native_pow(float64 b, float64 e);
    private static native float64 native_exp(float64 v);
    private static native float64 native_log(float64 v);
    private static native float64 native_log10(float64 v);
    private static native float64 native_log2(float64 v);
    private static native float64 native_sin(float64 v);
    private static native float64 native_cos(float64 v);
    private static native float64 native_tan(float64 v);
    private static native float64 native_asin(float64 v);
    private static native float64 native_acos(float64 v);
    private static native float64 native_atan(float64 v);
    private static native float64 native_atan2(float64 y, float64 x);
    private static native float64 native_sinh(float64 v);
    private static native float64 native_cosh(float64 v);
    private static native float64 native_tanh(float64 v);
    private static native float64 native_floor(float64 v);
    private static native float64 native_ceil(float64 v);
    private static native float64 native_round(float64 v);
    private static native float64 native_trunc(float64 v);
}
