package solix.time;

import solix.core.IStringable;
import solix.core.String;

public class Duration implements IStringable {
    private int64 _nanoseconds;

    public Duration(int64 nanos) {
        this._nanoseconds = nanos;
    }

    public int64 to_nanoseconds() {
        return this._nanoseconds;
    }

    public int64 to_milliseconds() {
        return this._nanoseconds / 1000000L;
    }

    public int64 to_seconds() {
        return this._nanoseconds / 1000000000L;
    }

    public int64 to_minutes() {
        return this.to_seconds() / 60L;
    }

    public int64 to_hours() {
        return this.to_minutes() / 60L;
    }

    public int64 to_days() {
        return this.to_hours() / 24L;
    }

    public Duration add(Duration other) {
        if (other == null) return this;
        return new Duration(this._nanoseconds + other._nanoseconds);
    }

    public Duration subtract(Duration other) {
        if (other == null) return this;
        return new Duration(this._nanoseconds - other._nanoseconds);
    }

    public Duration operator+(Duration other) {
        return this.add(other);
    }

    public Duration operator-(Duration other) {
        return this.subtract(other);
    }

    public Duration operator*(int32 factor) {
        return new Duration(this._nanoseconds * (int64)factor);
    }

    public Duration operator*(int64 factor) {
        return new Duration(this._nanoseconds * factor);
    }

    public Duration operator/(int32 divisor) {
        return new Duration(this._nanoseconds / (int64)divisor);
    }

    public Duration operator/(int64 divisor) {
        return new Duration(this._nanoseconds / divisor);
    }

    public bool equals(Duration other) {
        if (other == null) return false;
        return this._nanoseconds == other._nanoseconds;
    }

    public bool operator==(Duration other) {
        return this.equals(other);
    }

    public bool operator!=(Duration other) {
        return !this.equals(other);
    }

    public int32 compare_to(Duration other) {
        if (other == null) return 1;
        if (this._nanoseconds < other._nanoseconds) return -1;
        if (this._nanoseconds > other._nanoseconds) return 1;
        return 0;
    }

    public bool operator<(Duration other) {
        return this.compare_to(other) < 0;
    }

    public bool operator<=(Duration other) {
        return this.compare_to(other) <= 0;
    }

    public bool operator>(Duration other) {
        return this.compare_to(other) > 0;
    }

    public bool operator>=(Duration other) {
        return this.compare_to(other) >= 0;
    }

    public String to_string() {
        int64 ms = this.to_milliseconds();
        return String.from_int(ms).concat(new String("ms"));
    }

    public static Duration from_nanoseconds(int64 ns) {
        return new Duration(ns);
    }

    public static Duration from_milliseconds(int64 ms) {
        return new Duration(ms * 1000000L);
    }

    public static Duration from_seconds(int64 s) {
        return new Duration(s * 1000000000L);
    }

    public static Duration from_minutes(int64 m) {
        return from_seconds(m * 60L);
    }

    public static Duration from_hours(int64 h) {
        return from_minutes(h * 60L);
    }

    public static Duration from_days(int64 d) {
        return from_hours(d * 24L);
    }
}
