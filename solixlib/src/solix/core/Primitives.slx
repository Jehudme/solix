package solix.core;

alias int = int32;
alias long = int64;
alias short = int16;
alias byte = int8;
alias ubyte = uint8;
alias ushort = uint16;
alias uint = uint32;
alias ulong = uint64;
alias float = float32;
alias double = float64;

public class Primitives {
    public static int32 MIN_INT = -2147483647 - 1;
    public static int32 MAX_INT = 2147483647;

    public static float64 NaN = Primitives.nan();
    public static float64 POSITIVE_INFINITY = Primitives.positive_infinity();
    public static float64 NEGATIVE_INFINITY = Primitives.negative_infinity();
    public static float64 MIN_DOUBLE = Primitives.min_double();
    public static float64 MAX_DOUBLE = Primitives.max_double();

    public static int32 count_leading_zeros(int32 val) {
        return native_clz(val);
    }

    public static int32 count_trailing_zeros(int32 val) {
        return native_ctz(val);
    }

    public static int32 bit_count(int32 val) {
        return native_popcount(val);
    }

    public static int32 reverse_bytes(int32 val) {
        return native_bswap(val);
    }

    public static bool is_nan(float64 d) {
        return native_is_nan(d);
    }

    public static bool is_infinite(float64 d) {
        return native_is_infinite(d);
    }

    public static float64 nan() {
        return native_nan();
    }

    public static float64 positive_infinity() {
        return native_pos_inf();
    }

    public static float64 negative_infinity() {
        return native_neg_inf();
    }

    public static float64 min_double() {
        return native_min_double();
    }

    public static float64 max_double() {
        return native_max_double();
    }

    public static int32 parse_int(String s) {
        return String.parse_int(s);
    }

    public static float64 parse_double(String s) {
        return String.parse_double(s);
    }

    public static bool parse_bool(String s) {
        return String.parse_bool(s);
    }

    public static bool is_digit(char c) {
        return c >= '0' && c <= '9';
    }

    public static bool is_letter(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
    }

    public static bool is_whitespace(char c) {
        return c == ' ' || c == '\t' || c == '\n' || c == '\r';
    }

    public static bool is_upper_case(char c) {
        return c >= 'A' && c <= 'Z';
    }

    public static bool is_lower_case(char c) {
        return c >= 'a' && c <= 'z';
    }

    public static char to_upper_case(char c) {
        if (c >= 'a' && c <= 'z') {
            return (char)(c - 32);
        }
        return c;
    }

    public static char to_lower_case(char c) {
        if (c >= 'A' && c <= 'Z') {
            return (char)(c + 32);
        }
        return c;
    }

    private static native float64 native_min_double();
    private static native float64 native_max_double();
    private static native float64 native_nan();
    private static native float64 native_pos_inf();
    private static native float64 native_neg_inf();
    private static native bool native_is_nan(float64 val);
    private static native bool native_is_infinite(float64 val);

    private static native int32 native_clz(int32 val);
    private static native int32 native_ctz(int32 val);
    private static native int32 native_popcount(int32 val);
    private static native int32 native_bswap(int32 val);
}
