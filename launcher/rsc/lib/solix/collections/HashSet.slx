// ============================================================================
// Solix Standard Library - Generic Bucketed Hash Set (HashSet<T>)
// Package: solix.collections
// ============================================================================
package solix.collections;

import solix.core.*;

public class HashSetNode<T> {
    public T value;
    public HashSetNode<T> next_node = null;

    public HashSetNode(T val, HashSetNode<T> next) {
        this.value = val;
        this.next_node = next;
    }
}

public class HashSet<T> {
    private HashSetNode<T>[] buckets;
    private int32 element_count = 0;
    private int32 bucket_capacity = 16;

    // ------------------------------------------------------------------------
    // Constructors
    // ------------------------------------------------------------------------

    public HashSet() {
        this.bucket_capacity = 16;
        this.element_count = 0;
        this.buckets = new HashSetNode<T>[this.bucket_capacity];
    }

    public HashSet(int32 initial_capacity) {
        if (initial_capacity < 4) {
            initial_capacity = 4;
        }
        this.bucket_capacity = initial_capacity;
        this.element_count = 0;
        this.buckets = new HashSetNode<T>[this.bucket_capacity];
    }

    public HashSet(T[] initial_elements) {
        this.bucket_capacity = 16;
        this.element_count = 0;
        this.buckets = new HashSetNode<T>[this.bucket_capacity];

        if (initial_elements != null) {
            for (int32 copy_index = 0; copy_index < initial_elements.length; copy_index++) {
                this.add(initial_elements[copy_index]);
            }
        }
    }

    private int32 get_bucket_index(T item) {
        if (item == null) {
            return 0;
        }
        int32 hash = Objects.hash_code<T>(item);
        int32 index = hash % this.bucket_capacity;
        if (index < 0) {
            index = -index;
        }
        return index;
    }

    // ------------------------------------------------------------------------
    // Capacity and Sizing
    // ------------------------------------------------------------------------

    public int32 size() {
        return this.element_count;
    }

    public int32 capacity() {
        return this.bucket_capacity;
    }

    public bool is_empty() {
        return this.element_count == 0;
    }

    public void clear() {
        this.bucket_capacity = 16;
        this.element_count = 0;
        this.buckets = new HashSetNode<T>[this.bucket_capacity];
    }

    private void resize() {
        int32 new_capacity = this.bucket_capacity * 2;
        HashSetNode<T>[] old_buckets = this.buckets;
        int32 old_capacity = this.bucket_capacity;

        this.buckets = new HashSetNode<T>[new_capacity];
        this.bucket_capacity = new_capacity;
        this.element_count = 0;

        for (int32 i = 0; i < old_capacity; i++) {
            HashSetNode<T> current_node = old_buckets[i];
            while (current_node != null) {
                this.add(current_node.value);
                current_node = current_node.next_node;
            }
        }
    }

    // ------------------------------------------------------------------------
    // Search and Membership
    // ------------------------------------------------------------------------

    public bool contains(T search_item) {
        int32 index = this.get_bucket_index(search_item);
        HashSetNode<T> current_node = this.buckets[index];
        while (current_node != null) {
            if (Objects.equals<T>(current_node.value, search_item)) {
                return true;
            }
            current_node = current_node.next_node;
        }
        return false;
    }

    public bool add(T item) {
        if (this.contains(item)) {
            return false;
        }
        if (this.element_count >= this.bucket_capacity) {
            this.resize();
        }
        int32 index = this.get_bucket_index(item);
        HashSetNode<T> new_node = new HashSetNode<T>(item, this.buckets[index]);
        this.buckets[index] = new_node;
        this.element_count++;
        return true;
    }

    public bool remove(T target_item) {
        int32 index = this.get_bucket_index(target_item);
        HashSetNode<T> current_node = this.buckets[index];
        HashSetNode<T> previous_node = null;

        while (current_node != null) {
            if (Objects.equals<T>(current_node.value, target_item)) {
                if (previous_node == null) {
                    this.buckets[index] = current_node.next_node;
                } else {
                    previous_node.next_node = current_node.next_node;
                }
                this.element_count--;
                return true;
            }
            previous_node = current_node;
            current_node = current_node.next_node;
        }
        return false;
    }

    // ------------------------------------------------------------------------
    // Bulk Operations and Export
    // ------------------------------------------------------------------------

    public T[] to_array() {
        T[] export_array = new T[this.element_count];
        int32 cursor = 0;
        for (int32 i = 0; i < this.bucket_capacity; i++) {
            HashSetNode<T> current_node = this.buckets[i];
            while (current_node != null) {
                export_array[cursor] = current_node.value;
                cursor++;
                current_node = current_node.next_node;
            }
        }
        return export_array;
    }

    public List<T> to_list() {
        List<T> export_list = new List<T>(this.element_count);
        for (int32 i = 0; i < this.bucket_capacity; i++) {
            HashSetNode<T> current_node = this.buckets[i];
            while (current_node != null) {
                export_list.add(current_node.value);
                current_node = current_node.next_node;
            }
        }
        return export_list;
    }

    public HashSet<T> clone() {
        HashSet<T> duplicated_set = new HashSet<T>(this.bucket_capacity);
        for (int32 i = 0; i < this.bucket_capacity; i++) {
            HashSetNode<T> current_node = this.buckets[i];
            while (current_node != null) {
                duplicated_set.add(current_node.value);
                current_node = current_node.next_node;
            }
        }
        return duplicated_set;
    }
}
