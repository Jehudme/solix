// ============================================================================
// Solix Standard Library - Linear Associative ArrayMap (ArrayMap<K, V>)
// Package: solix.collections
// ============================================================================
package solix.collections;


public class ArrayMap<K, V> {
    private K[] keys_buffer;
    private V[] values_buffer;
    private int32 entry_count = 0;
    private int32 buffer_capacity = 0;

    // ------------------------------------------------------------------------
    // Constructors
    // ------------------------------------------------------------------------

    public ArrayMap() {
        this.buffer_capacity = 8;
        this.entry_count = 0;
        this.keys_buffer = new K[this.buffer_capacity];
        this.values_buffer = new V[this.buffer_capacity];
    }

    public ArrayMap(int32 initial_capacity) {
        if (initial_capacity < 0) {
            throw new InvalidArgumentException("Initial capacity of ArrayMap cannot be negative.");
        }
        int32 capacity_value = initial_capacity;
        if (capacity_value < 4) {
            capacity_value = 4;
        }
        this.buffer_capacity = capacity_value;
        this.entry_count = 0;
        this.keys_buffer = new K[this.buffer_capacity];
        this.values_buffer = new V[this.buffer_capacity];
    }

    // ------------------------------------------------------------------------
    // Capacity and Sizing
    // ------------------------------------------------------------------------

    public int32 size() {
        return this.entry_count;
    }

    public int32 capacity() {
        return this.buffer_capacity;
    }

    public bool is_empty() {
        return this.entry_count == 0;
    }

    public void clear() {
        this.buffer_capacity = 8;
        this.entry_count = 0;
        this.keys_buffer = new K[this.buffer_capacity];
        this.values_buffer = new V[this.buffer_capacity];
    }

    private void ensure_capacity(int32 required_capacity) {
        if (required_capacity <= this.buffer_capacity) {
            return;
        }

        int32 new_capacity = this.buffer_capacity * 2;
        if (new_capacity < required_capacity) {
            new_capacity = required_capacity;
        }

        K[] new_keys = new K[new_capacity];
        V[] new_values = new V[new_capacity];

        for (int32 copy_index = 0; copy_index < this.entry_count; copy_index++) {
            new_keys[copy_index] = this.keys_buffer[copy_index];
            new_values[copy_index] = this.values_buffer[copy_index];
        }

        this.keys_buffer = new_keys;
        this.values_buffer = new_values;
        this.buffer_capacity = new_capacity;
    }

    // ------------------------------------------------------------------------
    // Lookup Helpers
    // ------------------------------------------------------------------------

    public int32 index_of_key(K search_key) {
        for (int32 search_index = 0; search_index < this.entry_count; search_index++) {
            if (this.keys_buffer[search_index] == search_key) {
                return search_index;
            }
        }
        return -1;
    }

    public bool contains_key(K search_key) {
        return this.index_of_key(search_key) != -1;
    }

    public bool contains_value(V search_value) {
        for (int32 search_index = 0; search_index < this.entry_count; search_index++) {
            if (this.values_buffer[search_index] == search_value) {
                return true;
            }
        }
        return false;
    }

    // ------------------------------------------------------------------------
    // Entry Manipulation
    // ------------------------------------------------------------------------

    public void put(K key, V value) {
        int32 existing_index = this.index_of_key(key);
        if (existing_index != -1) {
            this.values_buffer[existing_index] = value;
            return;
        }

        this.ensure_capacity(this.entry_count + 1);
        this.keys_buffer[this.entry_count] = key;
        this.values_buffer[this.entry_count] = value;
        this.entry_count++;
    }

    public void put_if_absent(K key, V value) {
        int32 existing_index = this.index_of_key(key);
        if (existing_index != -1) {
            throw new DuplicateKeyException("Key already exists in Map.");
        }
        this.put(key, value);
    }

    public V get(K search_key) {
        int32 target_index = this.index_of_key(search_key);
        if (target_index == -1) {
            throw new KeyNotFoundException("Specified key was not found in Map.");
        }
        return this.values_buffer[target_index];
    }

    public V get_or_default(K search_key, V default_value) {
        int32 target_index = this.index_of_key(search_key);
        if (target_index == -1) {
            return default_value;
        }
        return this.values_buffer[target_index];
    }

    public V remove(K search_key) {
        int32 target_index = this.index_of_key(search_key);
        if (target_index == -1) {
            throw new KeyNotFoundException("Cannot remove key that does not exist in Map.");
        }

        V removed_value = this.values_buffer[target_index];

        for (int32 shift_index = target_index; shift_index < this.entry_count - 1; shift_index++) {
            this.keys_buffer[shift_index] = this.keys_buffer[shift_index + 1];
            this.values_buffer[shift_index] = this.values_buffer[shift_index + 1];
        }

        this.keys_buffer[this.entry_count - 1] = (K)null;
        this.values_buffer[this.entry_count - 1] = (V)null;
        this.entry_count--;
        return removed_value;
    }

    public bool remove_key(K search_key) {
        int32 target_index = this.index_of_key(search_key);
        if (target_index == -1) {
            return false;
        }

        for (int32 shift_index = target_index; shift_index < this.entry_count - 1; shift_index++) {
            this.keys_buffer[shift_index] = this.keys_buffer[shift_index + 1];
            this.values_buffer[shift_index] = this.values_buffer[shift_index + 1];
        }

        this.keys_buffer[this.entry_count - 1] = (K)null;
        this.values_buffer[this.entry_count - 1] = (V)null;
        this.entry_count--;
        return true;
    }

    // ------------------------------------------------------------------------
    // Collections and Views
    // ------------------------------------------------------------------------

    public K[] keys() {
        K[] export_keys = new K[this.entry_count];
        for (int32 copy_index = 0; copy_index < this.entry_count; copy_index++) {
            export_keys[copy_index] = this.keys_buffer[copy_index];
        }
        return export_keys;
    }

    public V[] values() {
        V[] export_values = new V[this.entry_count];
        for (int32 copy_index = 0; copy_index < this.entry_count; copy_index++) {
            export_values[copy_index] = this.values_buffer[copy_index];
        }
        return export_values;
    }

    public List<K> keys_list() {
        List<K> export_list = new List<K>(this.entry_count);
        for (int32 copy_index = 0; copy_index < this.entry_count; copy_index++) {
            export_list.add(this.keys_buffer[copy_index]);
        }
        return export_list;
    }

    public List<V> values_list() {
        List<V> export_list = new List<V>(this.entry_count);
        for (int32 copy_index = 0; copy_index < this.entry_count; copy_index++) {
            export_list.add(this.values_buffer[copy_index]);
        }
        return export_list;
    }

    public List<Pair<K, V>> entries() {
        List<Pair<K, V>> entry_list = new List<Pair<K, V>>(this.entry_count);
        for (int32 copy_index = 0; copy_index < this.entry_count; copy_index++) {
            Pair<K, V> pair_entry = new Pair<K, V>(this.keys_buffer[copy_index], this.values_buffer[copy_index]);
            entry_list.add(pair_entry);
        }
        return entry_list;
    }

    public ArrayMap<K, V> clone() {
        ArrayMap<K, V> duplicated_map = new ArrayMap<K, V>(this.buffer_capacity);
        for (int32 copy_index = 0; copy_index < this.entry_count; copy_index++) {
            duplicated_map.put(this.keys_buffer[copy_index], this.values_buffer[copy_index]);
        }
        return duplicated_map;
    }

    // ------------------------------------------------------------------------
    // Operator Overloads
    // ------------------------------------------------------------------------

    public ArrayMap<K, V> operator=(ArrayMap<K, V> other_map) {
        if (other_map == null) {
            this.clear();
            return this;
        }

        this.entry_count = other_map.entry_count;
        this.buffer_capacity = other_map.buffer_capacity;
        this.keys_buffer = new K[this.buffer_capacity];
        this.values_buffer = new V[this.buffer_capacity];

        for (int32 copy_index = 0; copy_index < this.entry_count; copy_index++) {
            this.keys_buffer[copy_index] = other_map.keys_buffer[copy_index];
            this.values_buffer[copy_index] = other_map.values_buffer[copy_index];
        }
        return this;
    }
}
