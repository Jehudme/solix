// ============================================================================
// Solix Standard Library - Generic Stack (Stack<T>)
// Package: solix.collections
// ============================================================================
package solix.collections;


public class Stack<T> {
    private T[] storage_buffer;
    private int32 element_count = 0;
    private int32 buffer_capacity = 0;

    // ------------------------------------------------------------------------
    // Constructors
    // ------------------------------------------------------------------------

    public Stack() {
        this.buffer_capacity = 8;
        this.element_count = 0;
        this.storage_buffer = new T[this.buffer_capacity];
    }

    public Stack(int32 initial_capacity) {
        if (initial_capacity < 0) {
            throw new InvalidArgumentException("Initial capacity of Stack cannot be negative.");
        }
        int32 capacity_value = initial_capacity;
        if (capacity_value < 4) {
            capacity_value = 4;
        }
        this.buffer_capacity = capacity_value;
        this.element_count = 0;
        this.storage_buffer = new T[this.buffer_capacity];
    }

    public Stack(T[] initial_elements) {
        if (initial_elements == null || initial_elements.length == 0) {
            this.buffer_capacity = 8;
            this.element_count = 0;
            this.storage_buffer = new T[this.buffer_capacity];
            return;
        }

        this.element_count = initial_elements.length;
        this.buffer_capacity = this.element_count * 2;
        this.storage_buffer = new T[this.buffer_capacity];

        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            this.storage_buffer[copy_index] = initial_elements[copy_index];
        }
    }

    // ------------------------------------------------------------------------
    // Capacity and Sizing
    // ------------------------------------------------------------------------

    public int32 size() {
        return this.element_count;
    }

    public int32 capacity() {
        return this.buffer_capacity;
    }

    public bool is_empty() {
        return this.element_count == 0;
    }

    public void clear() {
        this.buffer_capacity = 8;
        this.element_count = 0;
        this.storage_buffer = new T[this.buffer_capacity];
    }

    private void ensure_capacity(int32 required_capacity) {
        if (required_capacity <= this.buffer_capacity) {
            return;
        }

        int32 new_capacity = this.buffer_capacity * 2;
        if (new_capacity < required_capacity) {
            new_capacity = required_capacity;
        }

        T[] new_buffer = new T[new_capacity];
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            new_buffer[copy_index] = this.storage_buffer[copy_index];
        }

        this.storage_buffer = new_buffer;
        this.buffer_capacity = new_capacity;
    }

    // ------------------------------------------------------------------------
    // Stack Operations
    // ------------------------------------------------------------------------

    public void push(T item) {
        this.ensure_capacity(this.element_count + 1);
        this.storage_buffer[this.element_count] = item;
        this.element_count++;
    }

    public T pop() {
        if (this.element_count == 0) {
            throw new EmptyCollectionException("Cannot pop an element from an empty Stack.");
        }

        this.element_count--;
        T popped_element = this.storage_buffer[this.element_count];
        this.storage_buffer[this.element_count] = (T)null;
        return popped_element;
    }

    public T peek() {
        if (this.element_count == 0) {
            throw new EmptyCollectionException("Cannot peek at an element in an empty Stack.");
        }
        return this.storage_buffer[this.element_count - 1];
    }

    // ------------------------------------------------------------------------
    // Search and Inspection
    // ------------------------------------------------------------------------

    public bool contains(T search_item) {
        for (int32 search_index = 0; search_index < this.element_count; search_index++) {
            if (this.storage_buffer[search_index] == search_item) {
                return true;
            }
        }
        return false;
    }

    public T[] to_array() {
        T[] export_array = new T[this.element_count];
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            export_array[copy_index] = this.storage_buffer[copy_index];
        }
        return export_array;
    }

    public Stack<T> clone() {
        Stack<T> duplicated_stack = new Stack<T>(this.buffer_capacity);
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            duplicated_stack.push(this.storage_buffer[copy_index]);
        }
        return duplicated_stack;
    }

    // ------------------------------------------------------------------------
    // Operator Overloads
    // ------------------------------------------------------------------------

    public Stack<T> operator=(Stack<T> other_stack) {
        if (other_stack == null) {
            this.clear();
            return this;
        }

        this.element_count = other_stack.element_count;
        this.buffer_capacity = other_stack.buffer_capacity;
        this.storage_buffer = new T[this.buffer_capacity];

        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            this.storage_buffer[copy_index] = other_stack.storage_buffer[copy_index];
        }
        return this;
    }
}
