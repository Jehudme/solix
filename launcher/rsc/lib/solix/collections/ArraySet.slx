// ============================================================================
// Solix Standard Library - Linear ArraySet (ArraySet<T>)
// Package: solix.collections
// ============================================================================
package solix.collections;


public class ArraySet<T> {
    private T[] elements_buffer;
    private int32 element_count = 0;
    private int32 buffer_capacity = 0;

    // ------------------------------------------------------------------------
    // Constructors
    // ------------------------------------------------------------------------

    public ArraySet() {
        this.buffer_capacity = 8;
        this.element_count = 0;
        this.elements_buffer = new T[this.buffer_capacity];
    }

    public ArraySet(int32 initial_capacity) {
        if (initial_capacity < 0) {
            throw new InvalidArgumentException("Initial capacity of ArraySet cannot be negative.");
        }
        int32 capacity_value = initial_capacity;
        if (capacity_value < 4) {
            capacity_value = 4;
        }
        this.buffer_capacity = capacity_value;
        this.element_count = 0;
        this.elements_buffer = new T[this.buffer_capacity];
    }

    public ArraySet(T[] initial_elements) {
        this.buffer_capacity = 8;
        this.element_count = 0;
        this.elements_buffer = new T[this.buffer_capacity];

        if (initial_elements != null) {
            for (int32 copy_index = 0; copy_index < initial_elements.length; copy_index++) {
                this.add(initial_elements[copy_index]);
            }
        }
    }

    // ------------------------------------------------------------------------
    // Capacity and Sizing
    // ------------------------------------------------------------------------

    public int32 size() {
        return this.element_count;
    }

    public int32 capacity() {
        return this.buffer_capacity;
    }

    public bool is_empty() {
        return this.element_count == 0;
    }

    public void clear() {
        this.buffer_capacity = 8;
        this.element_count = 0;
        this.elements_buffer = new T[this.buffer_capacity];
    }

    private void ensure_capacity(int32 required_capacity) {
        if (required_capacity <= this.buffer_capacity) {
            return;
        }

        int32 new_capacity = this.buffer_capacity * 2;
        if (new_capacity < required_capacity) {
            new_capacity = required_capacity;
        }

        T[] new_buffer = new T[new_capacity];
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            new_buffer[copy_index] = this.elements_buffer[copy_index];
        }

        this.elements_buffer = new_buffer;
        this.buffer_capacity = new_capacity;
    }

    // ------------------------------------------------------------------------
    // Search and Membership
    // ------------------------------------------------------------------------

    public int32 index_of(T target_item) {
        for (int32 search_index = 0; search_index < this.element_count; search_index++) {
            if (this.elements_buffer[search_index] == target_item) {
                return search_index;
            }
        }
        return -1;
    }

    public bool contains(T target_item) {
        return this.index_of(target_item) != -1;
    }

    // ------------------------------------------------------------------------
    // Insertion and Removal
    // ------------------------------------------------------------------------

    public bool add(T item_to_add) {
        if (this.contains(item_to_add)) {
            return false;
        }

        this.ensure_capacity(this.element_count + 1);
        this.elements_buffer[this.element_count] = item_to_add;
        this.element_count++;
        return true;
    }

    public bool remove(T item_to_remove) {
        int32 target_index = this.index_of(item_to_remove);
        if (target_index == -1) {
            return false;
        }

        for (int32 shift_index = target_index; shift_index < this.element_count - 1; shift_index++) {
            this.elements_buffer[shift_index] = this.elements_buffer[shift_index + 1];
        }

        this.elements_buffer[this.element_count - 1] = (T)null;
        this.element_count--;
        return true;
    }

    // ------------------------------------------------------------------------
    // Bulk Operations and Set Algebra
    // ------------------------------------------------------------------------

    public void add_all(HashSet<T> other_set) {
        if (other_set == null) {
            return;
        }

        T[] other_items = other_set.to_array();
        for (int32 item_index = 0; item_index < other_items.length; item_index++) {
            this.add(other_items[item_index]);
        }
    }

    public void add_all(T[] item_array) {
        if (item_array == null) {
            return;
        }

        for (int32 item_index = 0; item_index < item_array.length; item_index++) {
            this.add(item_array[item_index]);
        }
    }

    public void retain_all(HashSet<T> other_set) {
        if (other_set == null) {
            this.clear();
            return;
        }

        int32 current_index = 0;
        while (current_index < this.element_count) {
            T current_item = this.elements_buffer[current_index];
            if (!other_set.contains(current_item)) {
                this.remove(current_item);
            } else {
                current_index++;
            }
        }
    }

    public void remove_all(HashSet<T> other_set) {
        if (other_set == null) {
            return;
        }

        T[] other_items = other_set.to_array();
        for (int32 item_index = 0; item_index < other_items.length; item_index++) {
            this.remove(other_items[item_index]);
        }
    }

    public bool is_subset_of(HashSet<T> other_set) {
        if (other_set == null) {
            return this.is_empty();
        }

        for (int32 check_index = 0; check_index < this.element_count; check_index++) {
            if (!other_set.contains(this.elements_buffer[check_index])) {
                return false;
            }
        }
        return true;
    }

    // ------------------------------------------------------------------------
    // Conversions and Duplication
    // ------------------------------------------------------------------------

    public T[] to_array() {
        T[] export_array = new T[this.element_count];
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            export_array[copy_index] = this.elements_buffer[copy_index];
        }
        return export_array;
    }

    public List<T> to_list() {
        List<T> export_list = new List<T>(this.element_count);
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            export_list.add(this.elements_buffer[copy_index]);
        }
        return export_list;
    }

    public ArraySet<T> clone() {
        ArraySet<T> duplicated_set = new ArraySet<T>(this.buffer_capacity);
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            duplicated_set.add(this.elements_buffer[copy_index]);
        }
        return duplicated_set;
    }

    // ------------------------------------------------------------------------
    // Operator Overloads
    // ------------------------------------------------------------------------

    public ArraySet<T> operator=(ArraySet<T> other_set) {
        if (other_set == null) {
            this.clear();
            return this;
        }

        this.element_count = other_set.element_count;
        this.buffer_capacity = other_set.buffer_capacity;
        this.elements_buffer = new T[this.buffer_capacity];

        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            this.elements_buffer[copy_index] = other_set.elements_buffer[copy_index];
        }
        return this;
    }
}
