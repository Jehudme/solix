// ============================================================================
// Solix Standard Library - Generic Dynamic Array (List<T>)
// Package: solix.collections
// ============================================================================
package solix.collections;

alias IndexOutOfBoundsException = solix.IndexOutOfBoundsException;
alias EmptyCollectionException = solix.EmptyCollectionException;
alias InvalidArgumentException = solix.InvalidArgumentException;
alias NoSuchElementException = solix.NoSuchElementException;
alias KeyNotFoundException = solix.KeyNotFoundException;
alias DuplicateKeyException = solix.DuplicateKeyException;

public class List<T> {
    private T[] storage_buffer;
    private int32 element_count = 0;
    private int32 buffer_capacity = 0;

    // ------------------------------------------------------------------------
    // Constructors
    // ------------------------------------------------------------------------

    public List() {
        this.buffer_capacity = 8;
        this.element_count = 0;
        this.storage_buffer = new T[this.buffer_capacity];
    }

    public List(int32 initial_capacity) {
        if (initial_capacity < 0) {
            throw new InvalidArgumentException("Initial capacity of List cannot be negative.");
        }
        int32 capacity_value = initial_capacity;
        if (capacity_value < 4) {
            capacity_value = 4;
        }
        this.buffer_capacity = capacity_value;
        this.element_count = 0;
        this.storage_buffer = new T[this.buffer_capacity];
    }

    public List(T[] initial_elements) {
        if (initial_elements == null || initial_elements.length == 0) {
            this.buffer_capacity = 8;
            this.element_count = 0;
            this.storage_buffer = new T[this.buffer_capacity];
            return;
        }

        this.element_count = initial_elements.length;
        this.buffer_capacity = this.element_count * 2;
        this.storage_buffer = new T[this.buffer_capacity];

        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            this.storage_buffer[copy_index] = initial_elements[copy_index];
        }
    }

    // ------------------------------------------------------------------------
    // Capacity and Sizing
    // ------------------------------------------------------------------------

    public int32 size() {
        return this.element_count;
    }

    public int32 capacity() {
        return this.buffer_capacity;
    }

    public bool is_empty() {
        return this.element_count == 0;
    }

    public void clear() {
        this.buffer_capacity = 8;
        this.element_count = 0;
        this.storage_buffer = new T[this.buffer_capacity];
    }

    private void ensure_capacity(int32 required_capacity) {
        if (required_capacity <= this.buffer_capacity) {
            return;
        }

        int32 new_capacity = this.buffer_capacity * 2;
        if (new_capacity < required_capacity) {
            new_capacity = required_capacity;
        }

        T[] new_buffer = new T[new_capacity];
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            new_buffer[copy_index] = this.storage_buffer[copy_index];
        }

        this.storage_buffer = new_buffer;
        this.buffer_capacity = new_capacity;
    }

    public void reserve(int32 minimum_capacity) {
        if (minimum_capacity > this.buffer_capacity) {
            this.ensure_capacity(minimum_capacity);
        }
    }

    // ------------------------------------------------------------------------
    // Element Access
    // ------------------------------------------------------------------------

    public T get(int32 index) {
        if (index < 0 || index >= this.element_count) {
            throw new IndexOutOfBoundsException(index, this.element_count);
        }
        return this.storage_buffer[index];
    }

    public void set(int32 index, T value) {
        if (index < 0 || index >= this.element_count) {
            throw new IndexOutOfBoundsException(index, this.element_count);
        }
        this.storage_buffer[index] = value;
    }

    public T first() {
        if (this.element_count == 0) {
            throw new EmptyCollectionException("Cannot retrieve first element from an empty List.");
        }
        return this.storage_buffer[0];
    }

    public T last() {
        if (this.element_count == 0) {
            throw new EmptyCollectionException("Cannot retrieve last element from an empty List.");
        }
        return this.storage_buffer[this.element_count - 1];
    }

    public T[] to_array() {
        T[] export_array = new T[this.element_count];
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            export_array[copy_index] = this.storage_buffer[copy_index];
        }
        return export_array;
    }

    // ------------------------------------------------------------------------
    // Insertion and Removal
    // ------------------------------------------------------------------------

    public void add(T item) {
        this.ensure_capacity(this.element_count + 1);
        this.storage_buffer[this.element_count] = item;
        this.element_count++;
    }

    public void insert(int32 index, T item) {
        if (index < 0 || index > this.element_count) {
            throw new IndexOutOfBoundsException(index, this.element_count);
        }

        this.ensure_capacity(this.element_count + 1);

        for (int32 shift_index = this.element_count; shift_index > index; shift_index--) {
            this.storage_buffer[shift_index] = this.storage_buffer[shift_index - 1];
        }

        this.storage_buffer[index] = item;
        this.element_count++;
    }

    public void add_all(List<T> items) {
        if (items == null || items.size() == 0) {
            return;
        }

        int32 incoming_count = items.size();
        this.ensure_capacity(this.element_count + incoming_count);

        for (int32 copy_index = 0; copy_index < incoming_count; copy_index++) {
            this.storage_buffer[this.element_count + copy_index] = items.get(copy_index);
        }
        this.element_count = this.element_count + incoming_count;
    }

    public T remove_at(int32 index) {
        if (index < 0 || index >= this.element_count) {
            throw new IndexOutOfBoundsException(index, this.element_count);
        }

        T removed_item = this.storage_buffer[index];

        for (int32 shift_index = index; shift_index < this.element_count - 1; shift_index++) {
            this.storage_buffer[shift_index] = this.storage_buffer[shift_index + 1];
        }

        this.storage_buffer[this.element_count - 1] = (T)null;
        this.element_count--;
        return removed_item;
    }

    public T pop() {
        if (this.element_count == 0) {
            throw new EmptyCollectionException("Cannot pop an element from an empty List.");
        }
        return this.remove_at(this.element_count - 1);
    }

    // ------------------------------------------------------------------------
    // Search and Inspection
    // ------------------------------------------------------------------------

    public int32 index_of(T item) {
        for (int32 search_index = 0; search_index < this.element_count; search_index++) {
            if (this.storage_buffer[search_index] == item) {
                return search_index;
            }
        }
        return -1;
    }

    public int32 last_index_of(T item) {
        for (int32 search_index = this.element_count - 1; search_index >= 0; search_index--) {
            if (this.storage_buffer[search_index] == item) {
                return search_index;
            }
        }
        return -1;
    }

    public bool contains(T item) {
        return this.index_of(item) != -1;
    }

    public bool remove(T item) {
        int32 target_index = this.index_of(item);
        if (target_index != -1) {
            this.remove_at(target_index);
            return true;
        }
        return false;
    }

    // ------------------------------------------------------------------------
    // Algorithms and Manipulations
    // ------------------------------------------------------------------------

    public void reverse() {
        int32 left_index = 0;
        int32 right_index = this.element_count - 1;

        while (left_index < right_index) {
            T temporary_element = this.storage_buffer[left_index];
            this.storage_buffer[left_index] = this.storage_buffer[right_index];
            this.storage_buffer[right_index] = temporary_element;

            left_index++;
            right_index--;
        }
    }

    public List<T> slice(int32 start_index, int32 end_index) {
        if (start_index < 0 || end_index > this.element_count || start_index > end_index) {
            throw new IndexOutOfBoundsException("Invalid slice bounds specified for List.");
        }

        List<T> sublist = new List<T>();
        if (start_index == end_index) {
            return sublist;
        }

        sublist.reserve(end_index - start_index);
        for (int32 copy_index = start_index; copy_index < end_index; copy_index++) {
            sublist.add(this.storage_buffer[copy_index]);
        }
        return sublist;
    }

    public List<T> clone() {
        List<T> duplicated_list = new List<T>(this.buffer_capacity);
        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            duplicated_list.add(this.storage_buffer[copy_index]);
        }
        return duplicated_list;
    }

    // ------------------------------------------------------------------------
    // Operator Overloads
    // ------------------------------------------------------------------------

    public List<T> operator=(List<T> other) {
        if (other == null) {
            this.clear();
            return this;
        }

        this.element_count = other.element_count;
        this.buffer_capacity = other.buffer_capacity;
        this.storage_buffer = new T[this.buffer_capacity];

        for (int32 copy_index = 0; copy_index < this.element_count; copy_index++) {
            this.storage_buffer[copy_index] = other.storage_buffer[copy_index];
        }
        return this;
    }
}