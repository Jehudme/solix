// ============================================================================
// IO Exception
// ============================================================================
public class IOException extends Exception {
    public IOException() {
        this.detailed_message = new String("An input/output error has occurred.");
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public IOException(char[] message_text) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public IOException(String message_string) {
        this.detailed_message = message_string;
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public IOException(char[] message_text, Exception cause_exception) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = cause_exception;
        this.error_code = 0;
    }

    public IOException(String message_string, Exception cause_exception) {
        this.detailed_message = message_string;
        this.underlying_cause = cause_exception;
        this.error_code = 0;
    }

    public override String to_string() {
        if (this.detailed_message != null) {
            return new String("IOException: ").concat(this.detailed_message);
        }
        return new String("IOException");
    }
}
