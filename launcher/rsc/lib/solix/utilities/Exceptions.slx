// ============================================================================
// Solix Standard Library - Comprehensive Exception Hierarchy
// Package: solix
// ============================================================================
package solix;

alias Console = solix.systems.Console;

// ============================================================================
// Base Exception Class
// ============================================================================
public class Exception {
    protected String detailed_message;
    protected Exception underlying_cause;
    protected int32 error_code = 0;

    public Exception() {
        this.detailed_message = new String("An exception has occurred.");
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public Exception(char[] message_text) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public Exception(String message_string) {
        this.detailed_message = message_string;
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public Exception(char[] message_text, Exception cause_exception) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = cause_exception;
        this.error_code = 0;
    }

    public Exception(String message_string, Exception cause_exception) {
        this.detailed_message = message_string;
        this.underlying_cause = cause_exception;
        this.error_code = 0;
    }

    public Exception(char[] message_text, int32 code_value) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = (Exception)null;
        this.error_code = code_value;
    }

    public Exception(String message_string, int32 code_value) {
        this.detailed_message = message_string;
        this.underlying_cause = (Exception)null;
        this.error_code = code_value;
    }

    public Exception(char[] message_text, Exception cause_exception, int32 code_value) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = cause_exception;
        this.error_code = code_value;
    }

    public Exception(String message_string, Exception cause_exception, int32 code_value) {
        this.detailed_message = message_string;
        this.underlying_cause = cause_exception;
        this.error_code = code_value;
    }

    // ------------------------------------------------------------------------
    // Virtual Methods
    // ------------------------------------------------------------------------

    public virtual String get_message() {
        return this.detailed_message;
    }

    public virtual char[] message() {
        if (this.detailed_message != null) {
            return this.detailed_message.raw();
        }
        return "Unknown Exception";
    }

    public virtual Exception get_cause() {
        return this.underlying_cause;
    }

    public virtual int32 get_error_code() {
        return this.error_code;
    }

    public virtual String to_string() {
        if (this.detailed_message != null) {
            return new String("Exception: ").concat(this.detailed_message);
        }
        return new String("Exception");
    }

    public virtual void print_stack_trace() {
        Console.error("Exception: ");
        if (this.detailed_message != null) {
            Console.errorln(this.detailed_message);
        } else {
            Console.errorln("Unknown error");
        }
        if (this.underlying_cause != null) {
            Console.error("Caused by: ");
            this.underlying_cause.print_stack_trace();
        }
    }
}

// ============================================================================
// Runtime Exception
// ============================================================================
public class RuntimeException extends Exception {
    public RuntimeException() {
        this.detailed_message = new String("A runtime exception has occurred.");
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public RuntimeException(char[] message_text) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public RuntimeException(String message_string) {
        this.detailed_message = message_string;
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public RuntimeException(char[] message_text, Exception cause_exception) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = cause_exception;
        this.error_code = 0;
    }

    public RuntimeException(String message_string, Exception cause_exception) {
        this.detailed_message = message_string;
        this.underlying_cause = cause_exception;
        this.error_code = 0;
    }

    public override String to_string() {
        if (this.detailed_message != null) {
            return new String("RuntimeException: ").concat(this.detailed_message);
        }
        return new String("RuntimeException");
    }
}

// ============================================================================
// Null Pointer Exception
// ============================================================================
public class NullPointerException extends RuntimeException {
    public NullPointerException() {
        this.detailed_message = new String("Null pointer dereference attempt.");
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public NullPointerException(char[] message_text) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public NullPointerException(String message_string) {
        this.detailed_message = message_string;
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public override String to_string() {
        if (this.detailed_message != null) {
            return new String("NullPointerException: ").concat(this.detailed_message);
        }
        return new String("NullPointerException");
    }
}

// ============================================================================
// Index Out Of Bounds Exception
// ============================================================================
public class IndexOutOfBoundsException extends RuntimeException {
    protected int32 invalid_index = -1;
    protected int32 valid_size = -1;

    public IndexOutOfBoundsException() {
        this.detailed_message = new String("Index was out of range.");
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public IndexOutOfBoundsException(char[] message_text) {
        this.detailed_message = new String(message_text);
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public IndexOutOfBoundsException(String message_string) {
        this.detailed_message = message_string;
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public IndexOutOfBoundsException(int32 attempted_index, int32 collection_size) {
        this.invalid_index = attempted_index;
        this.valid_size = collection_size;
        this.detailed_message = new String("Index out of bounds: attempted index ")
            .concat(new String(attempted_index))
            .concat(" for collection size ")
            .concat(new String(collection_size));
        this.underlying_cause = (Exception)null;
        this.error_code = 0;
    }

    public int32 get_invalid_index() {
        return this.invalid_index;
    }

    public int32 get_collection_size() {
        return this.valid_size;
    }

    public override String to_string() {
        if (this.detailed_message != null) {
            return new String("IndexOutOfBoundsException: ").concat(this.detailed_message);
        }
        return new String("IndexOutOfBoundsException");
    }
}

