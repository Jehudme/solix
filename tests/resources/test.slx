public class Phase3TestRunner {
    public static int32 compute_status_code(int32 base) {
        return base * 2;
    }

    public static void run() {
        int32 status = Phase3TestRunner.compute_status_code(21);
        if (status == 42) {
            Console.println("Status calculation OK!");
        } else {
            Console.println("Status calculation FAILED!");
        }
        Console.println("=== PHASE 3 TESTS OK ===");
    }
}

