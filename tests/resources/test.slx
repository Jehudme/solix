package com.solix.advanced.test;

alias Matrix = float64[][];
alias ID = uint64;
alias Console = solix.systems.Console;
alias ConsoleColor = solix.systems.ConsoleColor;

public enum ApplicationState {
    INITIALIZING,
    RUNNING,
    CRASHED,
    SHUTDOWN
}

public class Vector2 {
    public float64 x;
    public float64 y;
    public Vector2(float64 x, float64 y) {
        this.x = x;
        this.y = y;
    }
    public Vector2 operator=(Vector2 other) {
        Engine.print("ASSIGN OVERLOAD CALLED!");
        this.x = other.x;
        this.y = other.y;
        return this;
    }
    public Vector2 operator+(Vector2 other) {
        return new Vector2(this.x + other.x, this.y + other.y);
    }
}

public class Account {
    private int32 balance = 0;
    public void deposit(int32 amt) { balance = balance + amt; }
    public int32 get_balance() { return balance; }
}


class Shape {
    public abstract void area();
}

class Circle extends Shape {
    public override void area() {
        Engine.print("Circle Area!");
    }
}

class Animal {
    public virtual void speak() {
        Engine.print("I am an animal");
    }
}
public class Dog extends Animal {
    public override void speak() {
        Engine.print("I am a dog");
    }
}
public class Cat extends Animal {
    public override void speak() {
        Engine.print("I am a cat");
    }
}
public class A {
    public int32 aX;
    public A(int32 x) {
        this.aX = x;
    }
}
public class B extends A {
    public int32 bY;
    public B(int32 x, int32 y) : super(x) {
        this.bY = y;
    }
}
public class Engine {
    
    private const char[] engineName = "Solix V8";
    protected static int32 instanceCount = 0;
    internal bool isRunning = false;
    public float32 temperature = 25.0;
    
    public static void print(char[] s) { Console.println(s); }
    public static void print(int32 x) { Console.println(x); }
    public static void print(float64 x) { print("FLOAT64 PRINT"); }

    private class CoreProcessor {
        private ID coreId;
        public int32[] cache = new int32[1024];

        public CoreProcessor(ID id) {
            this.coreId = id;
            this.cache = new int32[1024];
            Engine.instanceCount++;
        }

        public enum CoreStatus {
            IDLE,
            PROCESSING,
            OVERHEATING
        }

        public CoreStatus currentStatus = CoreStatus.IDLE;

        public const inline void process(int32[] data) {
            if (this.currentStatus == CoreStatus.OVERHEATING) {
                return;
            }
            
            int32 temp = 0;
            
            for (int32 i = 0; i < 5; i++) {
                int32 temp = data[i] * 2; 
                
                if (temp > 100) {
                    while (temp > 0) {
                        temp--;
                        if (temp == 50) break;
                    }
                } else if (temp < 0) {
                    continue;
                } else {
                    this.cache[i] = temp;
                }
            }
        }
    }

    public Engine() {
        this.isRunning = true;
    }

    public static Matrix createIdentityMatrix(int32 size) {
        Matrix mat = new float64[][size];
        for (int32 i = 0; i < size; i++) {
            mat[i] = new float64[size];
            for (int32 j = 0; j < size; j++) {
                mat[i][j] = (i == j) ? 1.0 : 0.0;
            }
        }
        return mat;
    }

    public static void main(char[][] args) {
        Engine.print("START OF MAIN!");
        Engine.print(42);
        Vector2 v1 = new Vector2(10.0, 20.0);
        Vector2 v2 = new Vector2(5.0, 5.0);
        Vector2 v3 = v1 + v2;
        if (v3.x == 15.0) Engine.print("OPERATOR OVERLOAD SUCCESS");
        Vector2 v4 = new Vector2(0.0, 0.0);
        v4 = v3;
        if (v4.x == 15.0) Engine.print("ASSIGN OVERLOAD SUCCESS");
        B b = new B(10, 20);
        if (b.aX == 10) Engine.print("INHERITANCE SUCCESS!");

        Animal animal = new Animal();
        Animal dog = new Dog();
        Animal cat = new Cat();
        animal.speak();
        dog.speak();
        cat.speak();
        Engine.print(3.14159);
        if (args.length > 0) {
            Engine.print("WE HAVE ARGUMENTS!");
            Engine.print(args[0]);
        } else {
            Engine.print("NO ARGUMENTS GIVEN!");
        }
        if (instanceCount > 0) {
            return;
        }
        ApplicationState state = ApplicationState.INITIALIZING;
        
        int32 x = 10;
        int32 y = 20;
        int32 z = 30;

        x = y + z * 2 - 10 / 5;

        bool flag = false;
        bool result = flag = !true;

        int32[] numbers = { 1, 2, 3, 4, 5 };
        numbers[0]++;
        
        Engine myEngine = new Engine();
        Engine.CoreProcessor proc = new Engine.CoreProcessor(12345);
        proc.process(numbers);

        float64 casted = (float64) x;

        switch (state) {
            case ApplicationState.INITIALIZING:
                state = ApplicationState.RUNNING;
                break;
            case ApplicationState.CRASHED:
            case ApplicationState.SHUTDOWN:
                return;
            default:
                break;
        }

        float64 complexCall = Engine.createIdentityMatrix(x)[0][0] + (float64) proc.cache[0];

        do {
            x++;
        } while (x < 100);

        // Add some more complex logic to fulfill user request
        Matrix complexMath = Engine.createIdentityMatrix(5);
        complexMath[1][1] = complexCall * 3.14159;
        
        if (state == ApplicationState.RUNNING && myEngine.isRunning && proc.currentStatus == Engine.CoreProcessor.CoreStatus.IDLE) {
            Engine.print("Complex test passed successfully!");
        }

        // ARC STRESS TEST
        Engine.print("STARTING ARC STRESS TEST");
        int32 i = 0;
        while (i < 1000) {
            Animal a = new Animal();
            Dog d = new Dog();
            i = i + 1;
        }
        Engine.print("ARC STRESS TEST PASSED!");
        TemplateTestRunner.run();
    }
}

// ============================================================================
// Phase 18-21: Generics & Templates
// ============================================================================

// Class Template
public class Box<T> {
    public T value;
    public Box(T v) { this.value = v; }
    public T get_value() { return value; }
    public void set_value(T v) { this.value = v; }
}

// Template returning template
public class Pair<T1, T2> {
    public T1 first;
    public T2 second;
    public Pair(T1 f, T2 s) {
        this.first = f;
        this.second = s;
    }
    
    // Nested Box return
    public Box<T1> get_first_box() {
        return new Box<T1>(this.first);
    }
}

// Template Aliases
alias BoxAlias<U> = Box<U>;
alias IntBox = Box<int32>;

// Global Function Template
public void swap_boxes<T>(Box<T> a, Box<T> b) {
    T temp = a.get_value();
    a.set_value(b.get_value());
    b.set_value(temp);
}

// Explicit Template Specialization
public void print_val<char[]>(char[] val) {
    Engine.print("SPECIALIZED PRINT: ");
    Engine.print(val);
}

// Generic Blueprint
public void print_val<T>(T val) {
    Engine.print("GENERIC PRINT!");
}

// Complex Implicit Deduction
public void process_pair<T1, T2>(int32 id, T2 val2, T1 val1) {
    Engine.print("Process pair called successfully!");
}

alias interger = int32;


class TemplateTestRunner {
    public static void run() {
        Engine.print("--- TESTING TEMPLATES ---");
        
        // Concrete Alias & Class Template
        IntBox i_box1 = new IntBox(10);
        IntBox i_box2 = new IntBox(20);

        // Implicit Deduction
        swap_boxes<interger>(i_box1, i_box2);
        
        if (i_box1.get_value() == 20) Engine.print("TEMPLATE SWAP SUCCESS!");
        
        // Template Alias & Multiple generics
        Pair<int32, char[]> pair = new Pair<int32, char[]>(42, "hello generics");
        BoxAlias<int32> fb = pair.get_first_box();
        
        if (fb.get_value() == 42) Engine.print("NESTED TEMPLATE RETURN SUCCESS!");
        
        // Explicit Specialization Test
        print_val("THIS SHOULD BE SPECIALIZED");
        
        // Implicit Deduction complex
        process_pair(100, "second", false);
        
        // Phase 23 Test
        int32& ref_val = 10;
        if (ref_val == 10) Engine.print("PHASE 23 AMPERSAND LEXING OK");
        
        // Phase 24 Test: Typed Integer and Float Math
        int32 i_calc = 100 + 50 * 2 - 40 / 2; // 180
        float64 f_calc = 10.5 + 4.5 * 2.0; // 19.5
        if (i_calc == 180 && f_calc > 19.0) Engine.print("PHASE 24 TYPED ALU MATH OK");
        
        // Phase 25 Test: Array Length and Zero-Initialization
        int32[] safe_arr = new int32[4];
        if (safe_arr.length == 4 && safe_arr[0] == 0) Engine.print("PHASE 25 ARRAY SAFETY OK");

        // Phase 26 Test: ARC Store & Implicit This Ownership
        IntBox box_copy = i_box1;
        if (box_copy.get_value() == 20) Engine.print("PHASE 26 ARC EMISSION OK");

        // Phase 27 Test: Function and Scope Cleanup
        int32 loop_sum = 0;
        int32 loop_i = 0;
        while (loop_i < 10) {
            IntBox temp_b = new IntBox(loop_i);
            loop_sum = loop_sum + temp_b.get_value();
            loop_i = loop_i + 1;
            if (loop_i == 3) break;
        }
        if (loop_sum == 3) Engine.print("PHASE 27 CLEANUP AND FLOW LEAKS OK");

        // Phase 28 Test: Array Mutation & Implicit Constructor
        int32[] mut_arr = new int32[3];
        mut_arr[0] = 5;
        mut_arr[0]++;
        if (mut_arr[0] == 6) Engine.print("PHASE 28 OBJECT INIT AND ARRAY MUTATION OK");

        // Phase 29 Test: Static String Pool
        char[] pool_str = "STATIC STRING POOL OK";
        Engine.print(pool_str);

        // Phase 30 Test: Polymorphic Array Literal
        Animal[] poly_arr = { new Dog(), new Cat() };
        if (poly_arr.length == 2) Engine.print("PHASE 30 POLYMORPHIC ARRAYS OK");

        // Phase 31 Test: High Performance Engine Tuning
        int32 perf_sum = 0;
        for (int32 k = 0; k < 100; k++) { perf_sum = perf_sum + k; }
        if (perf_sum == 4950) Engine.print("PHASE 31 VM ENGINE TUNING OK");

        Engine.print("--- TEMPLATES OK ---");

        ConsoleTestRunner.run();
    }
}

public class ConsoleTestRunner {
    public static void run() {
        Console.println("=== TESTING CONSOLE STANDALONE ===");
        Console.println(true);
        Console.println('Z');
        Console.println(12345);
        Console.println(3.14159);
        int32[] test_ints = { 10, 20, 30 };
        Console.println(test_ints);
        Console.println("=== CONSOLE TESTS OK ===");
        ExtendedConsoleTestRunner.run();
    }
}

public class ExtendedConsoleTestRunner {
    public static void run() {
        Console.println("=== TESTING EXTENDED CONSOLE FEATURES ===");
        
        // Error & Warning Streams
        Console.error("Test Error Stream: ");
        Console.errorln("Critical condition logged to stderr");
        Console.warnln("Warning: This is a warning message");
        Console.infoln("Info: Standard info channel active");
        Console.debugln("Debug: Diagnostics active");

        // Color & Styling
        Console.set_color(ConsoleColor.GREEN);
        Console.println("Green text output OK");
        Console.reset_color();

        // Control
        Console.flush();

        // Input Handling verified in unit tests
        Console.println("Console.input_line() and typed inputs available");

        Console.println("=== EXTENDED CONSOLE TESTS OK ===");
        TryCatchTestRunner.run();
    }
}





// ============================================================================
// Phase X: Try-Catch Exceptions
// ============================================================================


class CustomException extends Exception {
    public int32 code;
    public CustomException(int32 c) {
        this.code = c;
    }
}

public class TryCatchTestRunner {
    public static void run() {
        Console.println("=== TESTING TRY-CATCH ===");
        
        bool caught = false;
        try {
            Console.println("Throwing exception...");
            throw new CustomException(404);
            Console.println("THIS SHOULD NOT BE REACHED");
        } catch (CustomException e) {
            Console.print("Caught CustomException! Code: ");
            Console.println(e.code);
            if (e.code == 404) {
                caught = true;
            }
        } catch (Exception e) {
            Console.println("Caught generic Exception! (WRONG)");
        }
        
        if (caught) {
            Console.println("=== TRY-CATCH TESTS OK ===");
            Phase32TestRunner.run();
        } else {
            Console.println("=== TRY-CATCH TESTS FAILED ===");
        }
    }
}

// ============================================================================
// Phase 32: Runtime VM & Memory Safety Integration Test
// ============================================================================

public class Phase32TestRunner {
    public static void run() {
        Console.println("=== TESTING PHASE 32 VM SAFETY & NEGATION ===");
        
        int32 pos = 100;
        int32 neg = -pos;
        int32 back_pos = -neg;
        if (neg == -100 && back_pos == 100) {
            Console.println("Integer negation verified OK!");
        } else {
            Console.println("Integer negation FAILED!");
        }

        int32 large_val = 258;
        int8 trunc_val = (int8)large_val;
        if ((int32)trunc_val == 2) {
            Console.println("Integer truncation cast verified OK!");
        } else {
            Console.println("Integer truncation cast FAILED!");
        }

        float64 f_val = 12.34;
        int32 cast_int = (int32)f_val;
        if (cast_int == 12) {
            Console.println("Float to integer cast verified OK!");
        } else {
            Console.println("Float to integer cast FAILED!");
        }

        int32 int_to_f = 99;
        float64 cast_f = (float64)int_to_f;
        if (cast_f > 98.9 && cast_f < 99.1) {
            Console.println("Integer to float cast verified OK!");
        } else {
            Console.println("Integer to float cast FAILED!");
        }

        Console.println("=== PHASE 32 TESTS OK ===");
        Phase33TestRunner.run();
    }
}

// ============================================================================
// Phase 33: Assembler CodeGen & ARC Safety Integration Test
// ============================================================================

public class Phase33Node {
    public int32 value = 77;
    public int32 extra = 88;
    public Phase33Node(int32 v) {
        this.value = v;
    }
}

public class Phase33DefaultNode {
    public int32 default_a = 42;
    public int32 default_b = 99;
    public Phase33DefaultNode() {}
}

public class Phase33TestRunner {
    public static Phase33Node return_local_node() {
        Phase33Node n = new Phase33Node(1234);
        return n;
    }

    public static void run() {
        Console.println("=== TESTING PHASE 33 ASSEMBLER CODEGEN & ARC ===");

        // Test 1: Field initializers in default constructor
        Phase33DefaultNode def_node = new Phase33DefaultNode();
        if (def_node.default_a == 42 && def_node.default_b == 99) {
            Console.println("Default constructor field initializers OK!");
        } else {
            Console.println("Default constructor field initializers FAILED!");
        }

        // Test 2: Postfix increment and decrement
        int32 counter = 10;
        int32 post_val = counter++;
        if (post_val == 10 && counter == 11) {
            Console.println("Postfix increment OK!");
        } else {
            Console.println("Postfix increment FAILED!");
        }

        int32 post_dec_val = counter--;
        if (post_dec_val == 11 && counter == 10) {
            Console.println("Postfix decrement OK!");
        } else {
            Console.println("Postfix decrement FAILED!");
        }

        // Test 3: Returning local reference without use-after-free
        Phase33Node ret = return_local_node();
        if (ret.value == 1234 && ret.extra == 88) {
            Console.println("Returning local reference OK!");
        } else {
            Console.println("Returning local reference FAILED!");
        }

        // Test 4: Array literals with reference types
        Phase33Node[] arr = { new Phase33Node(101), new Phase33Node(202) };
        if (arr[0].value == 101 && arr[1].value == 202) {
            Console.println("Array literal reference elements OK!");
        } else {
            Console.println("Array literal reference elements FAILED!");
        }

        Console.println("=== PHASE 33 TESTS OK ===");
        Phase34TestRunner.run();
    }
}

// ============================================================================
// Phase 34: Semantic Analysis & Type System Binding Integration Test
// ============================================================================

public class Phase34BaseEntity {
    public int32 base_val = 100;
    public Phase34BaseEntity() {}
    public virtual int32 get_code() {
        return this.base_val;
    }
}

public class Phase34DerivedEntity : Phase34BaseEntity {
    public int32 extra_val = 200;
    public Phase34DerivedEntity() {
        this.base_val = 150;
    }
    public override int32 get_code() {
        return this.base_val + this.extra_val;
    }
}

public class Phase34Holder {
    public Phase34BaseEntity entity;
    public Phase34Holder(Phase34BaseEntity e) {
        this.entity = e;
    }
}

public class Phase34Helper {
    public static T identity<T>(T val) {
        return val;
    }

    public static int32 process_entity(Phase34BaseEntity e) {
        return e.get_code();
    }
}

public class Phase34TestRunner {
    public static void run() {
        Console.println("=== TESTING PHASE 34 SEMANTIC ANALYSIS & BINDING ===");

        // Test 1: Method template instantiation idempotency
        int32 id1 = Phase34Helper.identity<int32>(555);
        int32 id2 = Phase34Helper.identity<int32>(777);
        if (id1 == 555 && id2 == 777) {
            Console.println("Method template idempotency OK!");
        } else {
            Console.println("Method template idempotency FAILED!");
        }

        // Test 2: Subtype polymorphism in method calls
        Phase34DerivedEntity derived = new Phase34DerivedEntity();
        int32 code = Phase34Helper.process_entity(derived);
        if (code == 350) {
            Console.println("Subtype polymorphism in method calls OK!");
        } else {
            Console.println("Subtype polymorphism in method calls FAILED!");
        }

        // Test 3: Subtype polymorphism in constructor calls
        Phase34Holder holder = new Phase34Holder(derived);
        if (holder.entity.get_code() == 350) {
            Console.println("Subtype polymorphism in constructor calls OK!");
        } else {
            Console.println("Subtype polymorphism in constructor calls FAILED!");
        }

        Console.println("=== PHASE 34 TESTS OK ===");
        Phase1TestRunner.run();
    }
}

