package com.solix.advanced.test;

public class Animal {
    public virtual void speak() {
        Engine.print("I am an animal");
    }
}

public class Dog extends Animal {
    public override void speak() {
        Engine.print("I am a dog");
    }
}

public class Cat extends Animal {
    public override void speak() {
        Engine.print("I am a cat");
    }
}

public class Engine {
    public static native void print(char[] s);
    
    public static void main(char[][] args) {
        Animal a = new Animal();
        Animal b = new Dog();
        Animal c = new Cat();
        
        a.speak(); // "I am an animal"
        b.speak(); // "I am a dog"
        c.speak(); // "I am a cat"
        
        // Static resolution
    }
}
